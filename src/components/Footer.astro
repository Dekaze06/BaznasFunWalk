<style>
  .site-footer {
    background: var(--ink-deep);
    color: #9AB499;
    padding-top: clamp(48px, 6vw, 80px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.3fr;
    gap: clamp(30px, 4vw, 56px);
    padding-bottom: 48px;
  }

  .footer-logo-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
  }

  .footer-logo {
    height: 44px;
    width: auto;
    object-fit: contain;
  }

  .footer-event-name {
    font-family: 'Baloo 2', sans-serif;
    font-weight: 800;
    font-size: 1.15rem;
    color: #FFFFFF;
    line-height: 1.1;
  }

  .footer-tagline {
    font-size: 0.8rem;
    color: var(--lime);
    font-weight: 600;
  }

  .footer-about {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #B5CEB3;
    margin-bottom: 20px;
  }

  .rekening-box {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--r-sm);
    padding: 14px 16px;
    font-size: 0.85rem;
  }

  .rek-title {
    color: var(--lime);
    font-weight: 700;
    margin-bottom: 6px;
  }

  .rek-item {
    color: #FFFFFF;
    margin-bottom: 4px;
  }

  .col-title {
    color: #FFFFFF;
    font-family: 'Baloo 2', sans-serif;
    font-size: 1.15rem;
    margin-bottom: 18px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    color: #B2CBB0;
    font-size: 0.94rem;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--lime);
    padding-left: 4px;
  }

  .footer-contact {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 20px;
  }

  .footer-contact li {
    display: flex;
    gap: 12px;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .footer-contact .icon {
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .footer-contact b {
    color: #FFFFFF;
    display: block;
    margin-bottom: 2px;
  }

  .footer-contact p {
    margin: 0;
    color: #A3BFA1;
  }

  .footer-contact a {
    color: var(--lime);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 22px 0;
    font-size: 0.86rem;
    color: #829D80;
  }

  .footer-bottom-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .bottom-links {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .bottom-links a {
    color: #A0BCA0;
  }

  .bottom-links a:hover {
    color: #FFFFFF;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
