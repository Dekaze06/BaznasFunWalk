---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { JERSEY_SIZES } from '../../lib/utils.js';
---

<AdminLayout title="Dashboard Utama — Admin BAZNAS Fun Walk 2026" activeSection="dashboard">
  <!-- Stats Row -->
  <div class="dashboard-stats-grid">
    <div class="stat-card">
      <div class="stat-icon-circle icon--green"></div>
      <div class="stat-content">
        <span class="stat-lbl">Total Pendaftar</span>
        <div class="stat-val" id="totalPesertaCount">8 Peserta</div>
        <div class="stat-progress-bar">
          <div class="bar-fill" id="totalProgressBar" style="width:0.8%"></div>
        </div>
        <small class="stat-hint">Target: <b>1.000 Peserta</b></small>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon-circle icon--blue"></div>
      <div class="stat-content">
        <span class="stat-lbl">Pembayaran Lunas</span>
        <div class="stat-val" id="paidPesertaCount">6 Peserta</div>
        <div class="stat-tags">
          <span class="badge badge--success">Verified</span>
          <span class="badge badge--warning" id="pendingTag">2 Pending</span>
        </div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon-circle icon--gold"></div>
      <div class="stat-content">
        <span class="stat-lbl">Total Dana Masuk</span>
        <div class="stat-val" id="totalRevenue">Rp 500.000</div>
        <div class="stat-sub-row">
          <span>Operasional: <b id="revReguler">Rp 300.000</b></span>
        </div>
      </div>
    </div>

    <div class="stat-card stat-card--charity">
      <div class="stat-icon-circle icon--lime"></div>
      <div class="stat-content">
        <span class="stat-lbl">Donasi ZIS Terkumpul</span>
        <div class="stat-val" id="totalZisDonation">Rp 200.000</div>
        <small class="stat-hint" style="color:var(--lime)">Dana ZIS murni (Charity Pack)</small>
      </div>
    </div>
  </div>

  <!-- Main Grid: Recent Registrations & Jersey Quota Breakdown -->
  <div class="admin-grid-2">
    <!-- Pendaftar Terbaru -->
    <div class="card-clean">
      <div class="card-header-flex">
        <div>
          <h3>Pendaftaran Terbaru</h3>
          <p class="hint" style="margin:0">Daftar transaksi dan registrasi peserta terkini</p>
        </div>
        <a href="/admin/peserta" class="btn btn-leaf btn-sm">Lihat Semua Data →</a>
      </div>

      <div class="table-responsive" style="margin-top:16px">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID Peserta</th>
              <th>Nama Lengkap</th>
              <th>Kategori</th>
              <th>Ukuran</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody id="recentPesertaTable">
            <!-- Rendered by client script -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Jersey Stock Widget -->
    <div class="card-clean">
      <div class="card-header-flex">
        <div>
          <h3>Distribusi Ukuran Jersey</h3>
          <p class="hint" style="margin:0">Alokasi produksi 1.000 pcs</p>
        </div>
        <a href="/admin/kuota" class="btn btn-ghost-dark btn-sm">Kelola Kuota</a>
      </div>

      <div class="jersey-stock-list" id="jerseyStockWidget">
        <!-- Rendered by client script -->
      </div>
    </div>
  </div>

  <!-- Fast Operations Row -->
  <div class="admin-quick-ops card-clean" style="margin-top:28px">
    <h3>Aksi Cepat Panitia</h3>
    <div class="ops-btn-grid" style="margin-top:16px">
      <a href="/admin/scanner" class="btn btn-leaf">
        <span>Buka Scanner QR Race Pack (RPC)</span>
      </a>
      <a href="/admin/peserta" class="btn btn-sun">
        <span>Verifikasi Bukti Transfer Pending</span>
      </a>
      <a href="/admin/impor" class="btn btn-ghost-dark">
        <span>Impor Peserta Kolektif (Excel)</span>
      </a>
      <a href="/admin/keuangan" class="btn btn-ghost-dark">
        <span>Laporan Rekap Keuangan & ZIS</span>
      </a>
    </div>
  </div>
</AdminLayout>

<style>
  .dashboard-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 28px;
  }

  .stat-card {
    background: #FFFFFF;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 22px;
    display: flex;
    gap: 16px;
    box-shadow: var(--shadow-sm);
  }

  .stat-card--charity {
    background: var(--ink);
    color: #FFFFFF;
    border-color: var(--leaf);
  }

  .stat-card--charity .stat-lbl { color: #A3C9A2; }
  .stat-card--charity .stat-val { color: #FFFFFF; }

  .stat-icon-circle {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-size: 1.4rem;
    flex-shrink: 0;
  }

  .icon--green { background: #E6F6EC; }
  .icon--blue { background: #E8F4FD; }
  .icon--gold { background: #FFF9E6; }
  .icon--lime { background: rgba(165, 208, 68, 0.2); }

  .stat-content {
    flex: 1;
    min-width: 0;
  }

  .stat-lbl {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--grey);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 4px;
  }

  .stat-val {
    font-family: 'Baloo 2', sans-serif;
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--ink);
    line-height: 1.1;
  }

  .stat-progress-bar {
    height: 6px;
    background: var(--paper-2);
    border-radius: 99px;
    overflow: hidden;
    margin: 8px 0 4px;
  }

  .bar-fill {
    height: 100%;
    background: var(--leaf);
    border-radius: 99px;
  }

  .stat-hint {
    font-size: 0.75rem;
    color: var(--grey);
  }

  .stat-sub-row {
    font-size: 0.82rem;
    color: var(--grey);
    margin-top: 4px;
  }

  .admin-grid-2 {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 24px;
  }

  .card-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding-bottom: 14px;
  }

  .card-header-flex h3 {
    font-size: 1.25rem;
    margin: 0;
  }

  /* Admin Table */
  .table-responsive {
    overflow-x: auto;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.88rem;
  }

  .admin-table th, .admin-table td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }

  .admin-table th {
    background: var(--paper-2);
    color: var(--ink);
    font-weight: 700;
  }

  /* Jersey Stock List */
  .jersey-stock-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }

  .stock-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .stock-size-pill {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--ink);
    color: var(--lime);
    font-family: 'Baloo 2', sans-serif;
    font-weight: 800;
    display: grid;
    place-items: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .stock-bar-wrapper {
    flex: 1;
  }

  .stock-info-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    margin-bottom: 4px;
  }

  .stock-track {
    height: 8px;
    background: var(--paper-2);
    border-radius: 99px;
    overflow: hidden;
  }

  .stock-fill {
    height: 100%;
    background: var(--leaf);
    border-radius: 99px;
  }

  .ops-btn-grid {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  @media (max-width: 1100px) {
    .dashboard-stats-grid {
      grid-template-columns: 1fr 1fr;
    }
    .admin-grid-2 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .dashboard-stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { getStore, getStockSummary } from '../../lib/store.js';
  import { formatRupiah } from '../../lib/utils.js';

  function renderDashboard() {
    const list = getStore();
    const paidList = list.filter(p => p.status === 'PAID');
    const pendingList = list.filter(p => p.status === 'PENDING');

    // Counts
    const totalCount = list.length;
    document.getElementById('totalPesertaCount').textContent = `${totalCount} Peserta`;
    document.getElementById('totalProgressBar').style.width = `${(totalCount / 1000) * 100}%`;
    document.getElementById('paidPesertaCount').textContent = `${paidList.length} Peserta`;
    document.getElementById('pendingTag').textContent = `${pendingList.length} Pending`;

    // Revenues
    let totalRev = 0;
    let totalZis = 0;
    let totalRegFee = 0;

    paidList.forEach(p => {
      totalRev += p.totalBayar;
      totalZis += p.nominalDonasi;
      totalRegFee += p.nominalRegistrasi;
    });

    document.getElementById('totalRevenue').textContent = formatRupiah(totalRev);
    document.getElementById('totalZisDonation').textContent = formatRupiah(totalZis);
    document.getElementById('revReguler').textContent = formatRupiah(totalRegFee);

    // Render Recent Table (first 5)
    const tbody = document.getElementById('recentPesertaTable');
    if (tbody) {
      tbody.innerHTML = list.slice(0, 5).map(p => `
        <tr>
          <td><b style="color:var(--leaf)">${p.id}</b></td>
          <td><b>${p.nama}</b><br><small style="color:var(--grey)">${p.whatsapp}</small></td>
          <td>${p.paket === 'charity' ? '<span class="badge badge--success">Charity Pack</span>' : '<span class="badge badge--info">Reguler</span>'}</td>
          <td><b>${p.ukuranJersey}</b></td>
          <td>
            ${p.status === 'PAID' ? '<span class="badge badge--success">Lunas</span>' : '<span class="badge badge--warning">Pending</span>'}
          </td>
          <td>
            <a href="/admin/peserta" class="btn btn-ghost-dark btn-sm" style="padding:2px 8px">Detail</a>
          </td>
        </tr>
      `).join('');
    }

    // Render Jersey Stock Widget
    const stockContainer = document.getElementById('jerseyStockWidget');
    if (stockContainer) {
      const stocks = getStockSummary();
      stockContainer.innerHTML = stocks.map(st => `
        <div class="stock-item">
          <div class="stock-size-pill">${st.size}</div>
          <div class="stock-bar-wrapper">
            <div class="stock-info-row">
              <b>Ukuran ${st.size} (${st.chest})</b>
              <span><b>${st.used}</b> / ${st.total} pcs (${st.remaining} sisa)</span>
            </div>
            <div class="stock-track">
              <div class="stock-fill" style="width:${st.percent}%"></div>
            </div>
          </div>
        </div>
      `).join('');
    }
  }

  renderDashboard();
</script>
