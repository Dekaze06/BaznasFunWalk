---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Manajemen Peserta — Admin BAZNAS Fun Walk 2026" activeSection="peserta">
  <!-- Data Table Card with Integrated Search & Filter in Header -->
  <div class="card-clean" style="padding:0; overflow:hidden">
    <div class="table-header-info">
      <div class="table-header-left">
        <b>Total Ditampilkan: <span id="filteredCount" style="color:var(--leaf); font-size:1.05rem">0</span> Peserta</b>
        <div class="bulk-actions" id="bulkActions" style="display:none; margin-left:12px">
          <span>Terpilih: <b id="selectedCount">0</b></span>
          <button type="button" class="btn btn-leaf btn-sm" onclick="bulkApprove()">Approve Terpilih</button>
        </div>
      </div>

      <!-- Right Side: Unified Compact Search & Filters -->
      <div class="table-header-right">
        <!-- Compact Search Box -->
        <div class="compact-search-box">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="filterKeyword" placeholder="Cari nama, ID, WA...">
        </div>

        <!-- Filter Trigger Button & Dropdown -->
        <div class="filter-dropdown-wrapper">
          <button type="button" class="filter-toggle-btn" id="filterToggleBtn" title="Filter Kategori & Status" onclick="toggleFilterPopover()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            <span>Filter</span>
            <span class="active-filter-indicator" id="filterIndicator" style="display:none"></span>
          </button>

          <!-- Floating Filter Popover -->
          <div class="filter-popover" id="filterPopover" style="display:none">
            <div class="popover-header">
              <b>Filter Kategori Peserta</b>
              <button type="button" class="popover-reset-btn" onclick="resetFilters()">Reset</button>
            </div>
            <div class="popover-body">
              <div class="popover-group">
                <label for="filterPaket">Kategori Paket:</label>
                <select id="filterPaket">
                  <option value="ALL">Semua Paket</option>
                  <option value="reguler">Paket Reguler 5K</option>
                  <option value="charity">Charity Pack (Donasi ZIS)</option>
                </select>
              </div>

              <div class="popover-group">
                <label for="filterStatus">Status Pembayaran:</label>
                <select id="filterStatus">
                  <option value="ALL">Semua Status</option>
                  <option value="PAID">✓ Lunas (PAID)</option>
                  <option value="PENDING">⌛ Menunggu Verifikasi</option>
                </select>
              </div>

              <div class="popover-group">
                <label for="filterSize">Ukuran Jersey:</label>
                <select id="filterSize">
                  <option value="ALL">Semua Ukuran</option>
                  <option value="S">Ukuran S</option>
                  <option value="M">Ukuran M</option>
                  <option value="L">Ukuran L</option>
                  <option value="XL">Ukuran XL</option>
                  <option value="XXL">Ukuran XXL</option>
                  <option value="XXXL">Ukuran XXXL</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- Export CSV Button -->
        <button type="button" class="btn btn-leaf btn-sm export-btn" onclick="exportToCSV()" title="Export ke CSV">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>CSV</span>
        </button>
      </div>
    </div>

    <div class="table-responsive">
      <table class="admin-data-table">
        <thead>
          <tr>
            <th style="width:40px"><input type="checkbox" id="selectAll"></th>
            <th>ID Peserta</th>
            <th>Nama & Kontak</th>
            <th>Paket</th>
            <th>Ukuran</th>
            <th>Total & Metode</th>
            <th>Status Bayar</th>
            <th>Status Race Pack</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody id="pesertaTableBody">
          <!-- Populated by JavaScript -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal Detail Peserta -->
  <div class="modal-backdrop" id="detailModal" style="display:none">
    <div class="modal-card" style="max-width:650px; text-align:left">
      <div class="modal-header-flex">
        <div>
          <h3 id="mTitle">Detail Peserta BFW26-0001</h3>
          <span class="hint" id="mWaktuDaftar">-</span>
        </div>
        <button type="button" class="btn-close" onclick="closeDetailModal()">✕</button>
      </div>

      <div class="modal-body-scroll">
        <div class="detail-grid">
          <div>
            <span class="lbl">Nama Lengkap:</span>
            <b id="mNama">-</b>
          </div>
          <div>
            <span class="lbl">NIK:</span>
            <b id="mNik">-</b>
          </div>
          <div>
            <span class="lbl">WhatsApp:</span>
            <b id="mWhatsapp">-</b>
          </div>
          <div>
            <span class="lbl">Email:</span>
            <b id="mEmail">-</b>
          </div>
          <div>
            <span class="lbl">Jenis Kelamin:</span>
            <b id="mGender">-</b>
          </div>
          <div>
            <span class="lbl">Golongan Darah:</span>
            <b id="mGolDarah">-</b>
          </div>
        </div>

        <div style="margin-top:16px">
          <span class="lbl">Alamat Domisili:</span>
          <p id="mAlamat" style="margin:0; font-size:0.92rem">-</p>
        </div>

        <div style="margin-top:16px">
          <span class="lbl">Kontak Darurat:</span>
          <p id="mDarurat" style="margin:0; font-size:0.92rem">-</p>
        </div>

        <div class="detail-financial-box" style="margin-top:20px">
          <div style="display:flex; justify-content:space-between; margin-bottom:6px">
            <span>Kategori Paket:</span>
            <b id="mPaket">-</b>
          </div>
          <div style="display:flex; justify-content:space-between; margin-bottom:6px">
            <span>Ukuran Jersey:</span>
            <b id="mSize">-</b>
          </div>
          <div style="display:flex; justify-content:space-between; margin-bottom:6px">
            <span>Biaya Event:</span>
            <b id="mRegFee">-</b>
          </div>
          <div style="display:flex; justify-content:space-between; margin-bottom:6px">
            <span>Donasi ZIS BAZNAS:</span>
            <b id="mDonasi" style="color:var(--leaf)">-</b>
          </div>
          <div class="financial-total">
            <span>Total Transaksi:</span>
            <b id="mTotal" style="color:var(--leaf); font-size:1.2rem">-</b>
          </div>
          <div style="margin-top:8px; font-size:0.85rem">
            <span>Metode: <b id="mMetode">-</b></span>
          </div>
        </div>
      </div>

      <div class="modal-footer-flex" style="margin-top:24px">
        <button type="button" class="btn btn-ghost-dark" onclick="closeDetailModal()">Tutup</button>
        <div style="display:flex; gap:10px">
          <button type="button" class="btn btn-leaf btn-sm" id="mApproveBtn" onclick="approveCurrent()">✓ Verifikasi Lunas</button>
          <a href="#" target="_blank" class="btn btn-sun btn-sm" id="mWaBtn">Hubungi WA</a>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  /* Header Integrated Controls */
  .table-header-info {
    padding: 16px 24px;
    background: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.92rem;
    gap: 16px;
    flex-wrap: wrap;
  }

  .table-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .table-header-right {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  /* Compact Search Box */
  .compact-search-box {
    position: relative;
    width: 240px;
  }

  .compact-search-box svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #94A3B8;
    pointer-events: none;
  }

  .compact-search-box input {
    width: 100%;
    height: 38px;
    padding-left: 36px;
    padding-right: 12px;
    border-radius: 8px;
    border: 1px solid #CBD5E1;
    font-size: 0.85rem;
    background: #F8FAFC;
    transition: all 0.2s;
  }

  .compact-search-box input:focus {
    outline: none;
    background: #FFFFFF;
    border-color: var(--leaf);
    box-shadow: 0 0 0 3px rgba(31, 137, 57, 0.15);
    width: 280px;
  }

  /* Filter Trigger Button */
  .filter-dropdown-wrapper {
    position: relative;
  }

  .filter-toggle-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 38px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1px solid #CBD5E1;
    background: #FFFFFF;
    color: #334155;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-toggle-btn:hover {
    background: #F1F5F9;
    border-color: #94A3B8;
  }

  .active-filter-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #E11D48;
    box-shadow: 0 0 6px #E11D48;
  }

  /* Floating Filter Popover */
  .filter-popover {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 280px;
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 14px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
    z-index: 200;
    padding: 16px;
    animation: fadeIn 0.15s ease;
  }

  .popover-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid #F1F5F9;
  }

  .popover-header b {
    font-size: 0.85rem;
    color: #0F172A;
  }

  .popover-reset-btn {
    background: none;
    border: 0;
    color: #E11D48;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .popover-group {
    margin-bottom: 12px;
  }

  .popover-group:last-child {
    margin-bottom: 0;
  }

  .popover-group label {
    display: block;
    font-size: 0.76rem;
    font-weight: 700;
    color: #64748B;
    margin-bottom: 4px;
  }

  .popover-group select {
    width: 100%;
    height: 36px;
    padding: 0 10px;
    border-radius: 8px;
    border: 1px solid #E2E8F0;
    font-size: 0.84rem;
    background: #F8FAFC;
    color: #1E293B;
  }

  .export-btn {
    height: 38px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 12px;
    font-size: 0.85rem;
  }

  .admin-data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .admin-data-table th, .admin-data-table td {
    padding: 14px 20px;
    border-bottom: 1px solid #F1F5F9;
  }

  .admin-data-table th {
    background: #FFFFFF;
    color: #475569;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .admin-data-table tr:hover td {
    background: #F8FAFC;
  }

  /* Modal */
  .modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .modal-card {
    background: #FFFFFF;
    border-radius: var(--r-lg);
    padding: 28px;
    width: 100%;
    box-shadow: var(--shadow-lg);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
  }

  .modal-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid var(--line);
    padding-bottom: 14px;
    margin-bottom: 16px;
  }

  .btn-close {
    background: transparent;
    border: 0;
    font-size: 1.2rem;
    cursor: pointer;
  }

  .modal-body-scroll {
    overflow-y: auto;
    flex: 1;
    padding-right: 8px;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .lbl {
    display: block;
    font-size: 0.75rem;
    color: var(--grey);
    text-transform: uppercase;
    font-weight: 700;
  }

  .detail-financial-box {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 16px;
    font-size: 0.9rem;
  }

  .financial-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1.5px solid var(--ink);
    padding-top: 8px;
    margin-top: 8px;
    font-weight: 700;
  }

  .modal-footer-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
</style>

<script>
  import { getStore, updateParticipantStatus } from '../../lib/store.js';
  import { formatRupiah, formatDateTime } from '../../lib/utils.js';

  let currentSelectedId = null;

  function renderTable() {
    const list = getStore();
    const kw = document.getElementById('filterKeyword')?.value?.toLowerCase().trim() || '';
    const paket = document.getElementById('filterPaket')?.value || 'ALL';
    const status = document.getElementById('filterStatus')?.value || 'ALL';
    const size = document.getElementById('filterSize')?.value || 'ALL';

    const filtered = list.filter(p => {
      const matchKw = !kw || 
        p.nama.toLowerCase().includes(kw) ||
        p.id.toLowerCase().includes(kw) ||
        p.whatsapp.includes(kw) ||
        p.nik.includes(kw);
      const matchPaket = paket === 'ALL' || p.paket === paket;
      const matchStatus = status === 'ALL' || p.status === status;
      const matchSize = size === 'ALL' || p.ukuranJersey === size;
      return matchKw && matchPaket && matchStatus && matchSize;
    });

    document.getElementById('filteredCount').textContent = filtered.length;

    const tbody = document.getElementById('pesertaTableBody');
    if (!tbody) return;

    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;padding:32px;color:var(--grey)">Tidak ada data peserta yang cocok.</td></tr>`;
      return;
    }

    tbody.innerHTML = filtered.map(p => `
      <tr>
        <td><input type="checkbox" class="row-check" value="${p.id}"></td>
        <td><b style="color:var(--leaf)">${p.id}</b></td>
        <td>
          <b>${p.nama}</b>
          <div style="font-size:0.8rem;color:var(--grey)">${p.whatsapp} · ${p.email}</div>
        </td>
        <td>
          ${p.paket === 'charity' ? '<span class="badge badge--success">Charity Pack</span>' : '<span class="badge badge--info">Reguler</span>'}
        </td>
        <td><b style="background:var(--paper-2);padding:2px 8px;border-radius:4px">${p.ukuranJersey}</b></td>
        <td>
          <b>${formatRupiah(p.totalBayar)}</b>
          <div style="font-size:0.78rem;color:var(--grey)">${p.metodeBayar}</div>
        </td>
        <td>
          ${p.status === 'PAID' ? '<span class="badge badge--success">Lunas</span>' : '<span class="badge badge--warning">Pending</span>'}
        </td>
        <td>
          ${p.racepackClaimed ? '<span style="color:var(--leaf);font-weight:700">✓ Sudah Diambil</span>' : '<span style="color:var(--grey)">Belum Diambil</span>'}
        </td>
        <td>
          <button type="button" class="btn btn-ghost-dark btn-sm" onclick="openDetail('${p.id}')">Detail</button>
        </td>
      </tr>
    `).join('');
  }

  // Filter Listeners
  ['filterKeyword', 'filterPaket', 'filterStatus', 'filterSize'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', renderTable);
    document.getElementById(id)?.addEventListener('change', renderTable);
  });

  // Modal Detail Functions
  window.openDetail = function(id) {
    const list = getStore();
    const p = list.find(item => item.id === id);
    if (!p) return;

    currentSelectedId = id;

    document.getElementById('mTitle').textContent = `Detail Peserta — ${p.id}`;
    document.getElementById('mWaktuDaftar').textContent = `Terdaftar pada ${formatDateTime(p.waktuDaftar)}`;
    document.getElementById('mNama').textContent = p.nama;
    document.getElementById('mNik').textContent = p.nik;
    document.getElementById('mWhatsapp').textContent = p.whatsapp;
    document.getElementById('mEmail').textContent = p.email;
    document.getElementById('mGender').textContent = p.gender;
    document.getElementById('mGolDarah').textContent = p.golDarah;
    document.getElementById('mAlamat').textContent = p.alamat;
    document.getElementById('mDarurat').textContent = `${p.kontakDaruratNama} (${p.kontakDaruratHp})`;

    document.getElementById('mPaket').textContent = p.paketNama;
    document.getElementById('mSize').textContent = `Ukuran ${p.ukuranJersey}`;
    document.getElementById('mRegFee').textContent = formatRupiah(p.nominalRegistrasi);
    document.getElementById('mDonasi').textContent = formatRupiah(p.nominalDonasi);
    document.getElementById('mTotal').textContent = formatRupiah(p.totalBayar);
    document.getElementById('mMetode').textContent = p.metodeBayar;

    const approveBtn = document.getElementById('mApproveBtn');
    if (approveBtn) {
      approveBtn.style.display = p.status === 'PAID' ? 'none' : 'inline-block';
    }

    const waBtn = document.getElementById('mWaBtn');
    if (waBtn) {
      const cleanPhone = p.whatsapp.replace(/[^0-9]/g, '').replace(/^0/, '62');
      waBtn.href = `https://wa.me/${cleanPhone}?text=Halo%20${encodeURIComponent(p.nama)},%20ini%20dari%20Panitia%20BAZNAS%20Fun%20Walk%202026.%20Kode%20Pendaftaran%20Anda:%20${p.id}`;
    }

    document.getElementById('detailModal').style.display = 'flex';
  };

  window.closeDetailModal = function() {
    document.getElementById('detailModal').style.display = 'none';
  };

  window.approveCurrent = function() {
    if (!currentSelectedId) return;
    updateParticipantStatus(currentSelectedId, 'PAID');
    alert(`Status pendaftaran ${currentSelectedId} berhasil diverifikasi menjadi LUNAS!`);
    closeDetailModal();
    renderTable();
  };

  // CSV Export
  window.exportToCSV = function() {
    const list = getStore();
    const headers = ['ID Peserta', 'Nama', 'NIK', 'WhatsApp', 'Email', 'Gender', 'Alamat', 'Paket', 'Ukuran Jersey', 'Total Bayar', 'Metode', 'Status Bayar', 'Klaim RPC'];
    const rows = list.map(p => [
      p.id,
      `"${p.nama}"`,
      `'${p.nik}`,
      `'${p.whatsapp}`,
      p.email,
      p.gender,
      `"${p.alamat}"`,
      p.paket,
      p.ukuranJersey,
      p.totalBayar,
      p.metodeBayar,
      p.status,
      p.racepackClaimed ? 'SUDAH' : 'BELUM'
    ]);

    const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement('a');
    link.setAttribute('href', encodedUri);
    link.setAttribute('download', `peserta_baznas_funwalk_${new Date().toISOString().slice(0,10)}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  // Filter Popover Toggle & Controls
  window.toggleFilterPopover = function() {
    const pop = document.getElementById('filterPopover');
    if (!pop) return;
    const isShown = pop.style.display === 'block';
    pop.style.display = isShown ? 'none' : 'block';
  };

  window.resetFilters = function() {
    if (document.getElementById('filterPaket')) document.getElementById('filterPaket').value = 'ALL';
    if (document.getElementById('filterStatus')) document.getElementById('filterStatus').value = 'ALL';
    if (document.getElementById('filterSize')) document.getElementById('filterSize').value = 'ALL';
    updateFilterIndicator();
    renderTable();
  };

  function updateFilterIndicator() {
    const paket = document.getElementById('filterPaket')?.value || 'ALL';
    const status = document.getElementById('filterStatus')?.value || 'ALL';
    const size = document.getElementById('filterSize')?.value || 'ALL';
    const indicator = document.getElementById('filterIndicator');
    if (indicator) {
      const hasActive = paket !== 'ALL' || status !== 'ALL' || size !== 'ALL';
      indicator.style.display = hasActive ? 'inline-block' : 'none';
    }
  }

  // Tutup filter popover saat klik di luar
  document.addEventListener('click', (e) => {
    const wrapper = document.querySelector('.filter-dropdown-wrapper');
    const pop = document.getElementById('filterPopover');
    if (wrapper && pop && !wrapper.contains(e.target)) {
      pop.style.display = 'none';
    }
  });

  ['filterPaket', 'filterStatus', 'filterSize'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', updateFilterIndicator);
  });

  renderTable();
</script>
