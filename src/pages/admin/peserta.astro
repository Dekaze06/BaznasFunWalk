---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Manajemen Peserta — Admin BAZNAS Fun Walk 2026" activeSection="peserta">
  <!-- Top Toolbar -->
  <div class="card-clean" style="margin-bottom:24px; padding:20px">
    <div class="filter-toolbar">
      <div class="search-input-box">
        <span class="search-icon"></span>
        <input type="text" id="filterKeyword" placeholder="Cari Nama, ID (BFW26-...), No. WhatsApp, atau NIK...">
      </div>

      <div class="filter-selects">
        <select id="filterPaket">
          <option value="ALL">Semua Paket</option>
          <option value="reguler">Paket Reguler 5K</option>
          <option value="charity">Charity Pack (Donasi ZIS)</option>
        </select>

        <select id="filterStatus">
          <option value="ALL">Semua Status Bayar</option>
          <option value="PAID">Lunas (PAID)</option>
          <option value="PENDING">Menunggu Verifikasi</option>
        </select>

        <select id="filterSize">
          <option value="ALL">Semua Ukuran</option>
          <option value="S">S</option>
          <option value="M">M</option>
          <option value="L">L</option>
          <option value="XL">XL</option>
          <option value="XXL">XXL</option>
          <option value="XXXL">XXXL</option>
        </select>

        <button type="button" class="btn btn-leaf btn-sm" onclick="exportToCSV()">
          <span>Export CSV</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Data Table Card -->
  <div class="card-clean" style="padding:0; overflow:hidden">
    <div class="table-header-info">
      <div>
        <b>Total Ditampilkan: <span id="filteredCount" style="color:var(--leaf)">0</span> Peserta</b>
      </div>
      <div class="bulk-actions" id="bulkActions" style="display:none">
        <span>Terpilih: <b id="selectedCount">0</b></span>
        <button type="button" class="btn btn-leaf btn-sm" onclick="bulkApprove()">Approve Terpilih</button>
      </div>
    </div>

    <div class="table-responsive">
      <table class="admin-data-table">
        <thead>
          <tr>
            <th style="width:40px"><input type="checkbox" id="selectAll"></th>
            <th>ID Peserta</th>
            <th>Nama & Kontak</th>
            <th>Paket</th>
            <th>Ukuran</th>
            <th>Total & Metode</th>
            <th>Status Bayar</th>
            <th>Status Race Pack</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody id="pesertaTableBody">
          <!-- Populated by JavaScript -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal Detail Peserta -->
  <div class="modal-backdrop" id="detailModal" style="display:none">
    <div class="modal-card" style="max-width:650px; text-align:left">
      <div class="modal-header-flex">
        <div>
          <h3 id="mTitle">Detail Peserta BFW26-0001</h3>
          <span class="hint" id="mWaktuDaftar">-</span>
        </div>
        <button type="button" class="btn-close" onclick="closeDetailModal()">✕</button>
      </div>

      <div class="modal-body-scroll">
        <div class="detail-grid">
          <div>
            <span class="lbl">Nama Lengkap:</span>
            <b id="mNama">-</b>
          </div>
          <div>
            <span class="lbl">NIK:</span>
            <b id="mNik">-</b>
          </div>
          <div>
            <span class="lbl">WhatsApp:</span>
            <b id="mWhatsapp">-</b>
          </div>
          <div>
            <span class="lbl">Email:</span>
            <b id="mEmail">-</b>
          </div>
          <div>
            <span class="lbl">Jenis Kelamin:</span>
            <b id="mGender">-</b>
          </div>
          <div>
            <span class="lbl">Golongan Darah:</span>
            <b id="mGolDarah">-</b>
          </div>
        </div>

        <div style="margin-top:16px">
          <span class="lbl">Alamat Domisili:</span>
          <p id="mAlamat" style="margin:0; font-size:0.92rem">-</p>
        </div>

        <div style="margin-top:16px">
          <span class="lbl">Kontak Darurat:</span>
          <p id="mDarurat" style="margin:0; font-size:0.92rem">-</p>
        </div>

        <div class="detail-financial-box" style="margin-top:20px">
          <div style="display:flex; justify-content:space-between; margin-bottom:6px">
            <span>Kategori Paket:</span>
            <b id="mPaket">-</b>
          </div>
          <div style="display:flex; justify-content:space-between; margin-bottom:6px">
            <span>Ukuran Jersey:</span>
            <b id="mSize">-</b>
          </div>
          <div style="display:flex; justify-content:space-between; margin-bottom:6px">
            <span>Biaya Event:</span>
            <b id="mRegFee">-</b>
          </div>
          <div style="display:flex; justify-content:space-between; margin-bottom:6px">
            <span>Donasi ZIS BAZNAS:</span>
            <b id="mDonasi" style="color:var(--leaf)">-</b>
          </div>
          <div class="financial-total">
            <span>Total Transaksi:</span>
            <b id="mTotal" style="color:var(--leaf); font-size:1.2rem">-</b>
          </div>
          <div style="margin-top:8px; font-size:0.85rem">
            <span>Metode: <b id="mMetode">-</b></span>
          </div>
        </div>
      </div>

      <div class="modal-footer-flex" style="margin-top:24px">
        <button type="button" class="btn btn-ghost-dark" onclick="closeDetailModal()">Tutup</button>
        <div style="display:flex; gap:10px">
          <button type="button" class="btn btn-leaf btn-sm" id="mApproveBtn" onclick="approveCurrent()">✓ Verifikasi Lunas</button>
          <a href="#" target="_blank" class="btn btn-sun btn-sm" id="mWaBtn">Hubungi WA</a>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .filter-toolbar {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }

  .search-input-box {
    position: relative;
    flex: 1;
    min-width: 260px;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--grey);
  }

  .search-input-box input {
    padding-left: 40px;
    height: 42px;
  }

  .filter-selects {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .filter-selects select {
    height: 42px;
    padding: 0 12px;
    width: auto;
  }

  .table-header-info {
    padding: 14px 20px;
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
  }

  .admin-data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .admin-data-table th, .admin-data-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }

  .admin-data-table th {
    background: #FFFFFF;
    color: var(--ink);
    font-weight: 700;
  }

  .admin-data-table tr:hover {
    background: #F9FCF9;
  }

  /* Modal */
  .modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .modal-card {
    background: #FFFFFF;
    border-radius: var(--r-lg);
    padding: 28px;
    width: 100%;
    box-shadow: var(--shadow-lg);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
  }

  .modal-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid var(--line);
    padding-bottom: 14px;
    margin-bottom: 16px;
  }

  .btn-close {
    background: transparent;
    border: 0;
    font-size: 1.2rem;
    cursor: pointer;
  }

  .modal-body-scroll {
    overflow-y: auto;
    flex: 1;
    padding-right: 8px;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .lbl {
    display: block;
    font-size: 0.75rem;
    color: var(--grey);
    text-transform: uppercase;
    font-weight: 700;
  }

  .detail-financial-box {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 16px;
    font-size: 0.9rem;
  }

  .financial-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1.5px solid var(--ink);
    padding-top: 8px;
    margin-top: 8px;
    font-weight: 700;
  }

  .modal-footer-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
</style>

<script>
  import { getStore, updateParticipantStatus } from '../../lib/store.js';
  import { formatRupiah, formatDateTime } from '../../lib/utils.js';

  let currentSelectedId = null;

  function renderTable() {
    const list = getStore();
    const kw = document.getElementById('filterKeyword')?.value?.toLowerCase().trim() || '';
    const paket = document.getElementById('filterPaket')?.value || 'ALL';
    const status = document.getElementById('filterStatus')?.value || 'ALL';
    const size = document.getElementById('filterSize')?.value || 'ALL';

    const filtered = list.filter(p => {
      const matchKw = !kw || 
        p.nama.toLowerCase().includes(kw) ||
        p.id.toLowerCase().includes(kw) ||
        p.whatsapp.includes(kw) ||
        p.nik.includes(kw);
      const matchPaket = paket === 'ALL' || p.paket === paket;
      const matchStatus = status === 'ALL' || p.status === status;
      const matchSize = size === 'ALL' || p.ukuranJersey === size;
      return matchKw && matchPaket && matchStatus && matchSize;
    });

    document.getElementById('filteredCount').textContent = filtered.length;

    const tbody = document.getElementById('pesertaTableBody');
    if (!tbody) return;

    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;padding:32px;color:var(--grey)">Tidak ada data peserta yang cocok.</td></tr>`;
      return;
    }

    tbody.innerHTML = filtered.map(p => `
      <tr>
        <td><input type="checkbox" class="row-check" value="${p.id}"></td>
        <td><b style="color:var(--leaf)">${p.id}</b></td>
        <td>
          <b>${p.nama}</b>
          <div style="font-size:0.8rem;color:var(--grey)">${p.whatsapp} · ${p.email}</div>
        </td>
        <td>
          ${p.paket === 'charity' ? '<span class="badge badge--success">Charity Pack</span>' : '<span class="badge badge--info">Reguler</span>'}
        </td>
        <td><b style="background:var(--paper-2);padding:2px 8px;border-radius:4px">${p.ukuranJersey}</b></td>
        <td>
          <b>${formatRupiah(p.totalBayar)}</b>
          <div style="font-size:0.78rem;color:var(--grey)">${p.metodeBayar}</div>
        </td>
        <td>
          ${p.status === 'PAID' ? '<span class="badge badge--success">Lunas</span>' : '<span class="badge badge--warning">Pending</span>'}
        </td>
        <td>
          ${p.racepackClaimed ? '<span style="color:var(--leaf);font-weight:700">✓ Sudah Diambil</span>' : '<span style="color:var(--grey)">Belum Diambil</span>'}
        </td>
        <td>
          <button type="button" class="btn btn-ghost-dark btn-sm" onclick="openDetail('${p.id}')">Detail</button>
        </td>
      </tr>
    `).join('');
  }

  // Filter Listeners
  ['filterKeyword', 'filterPaket', 'filterStatus', 'filterSize'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', renderTable);
    document.getElementById(id)?.addEventListener('change', renderTable);
  });

  // Modal Detail Functions
  window.openDetail = function(id) {
    const list = getStore();
    const p = list.find(item => item.id === id);
    if (!p) return;

    currentSelectedId = id;

    document.getElementById('mTitle').textContent = `Detail Peserta — ${p.id}`;
    document.getElementById('mWaktuDaftar').textContent = `Terdaftar pada ${formatDateTime(p.waktuDaftar)}`;
    document.getElementById('mNama').textContent = p.nama;
    document.getElementById('mNik').textContent = p.nik;
    document.getElementById('mWhatsapp').textContent = p.whatsapp;
    document.getElementById('mEmail').textContent = p.email;
    document.getElementById('mGender').textContent = p.gender;
    document.getElementById('mGolDarah').textContent = p.golDarah;
    document.getElementById('mAlamat').textContent = p.alamat;
    document.getElementById('mDarurat').textContent = `${p.kontakDaruratNama} (${p.kontakDaruratHp})`;

    document.getElementById('mPaket').textContent = p.paketNama;
    document.getElementById('mSize').textContent = `Ukuran ${p.ukuranJersey}`;
    document.getElementById('mRegFee').textContent = formatRupiah(p.nominalRegistrasi);
    document.getElementById('mDonasi').textContent = formatRupiah(p.nominalDonasi);
    document.getElementById('mTotal').textContent = formatRupiah(p.totalBayar);
    document.getElementById('mMetode').textContent = p.metodeBayar;

    const approveBtn = document.getElementById('mApproveBtn');
    if (approveBtn) {
      approveBtn.style.display = p.status === 'PAID' ? 'none' : 'inline-block';
    }

    const waBtn = document.getElementById('mWaBtn');
    if (waBtn) {
      const cleanPhone = p.whatsapp.replace(/[^0-9]/g, '').replace(/^0/, '62');
      waBtn.href = `https://wa.me/${cleanPhone}?text=Halo%20${encodeURIComponent(p.nama)},%20ini%20dari%20Panitia%20BAZNAS%20Fun%20Walk%202026.%20Kode%20Pendaftaran%20Anda:%20${p.id}`;
    }

    document.getElementById('detailModal').style.display = 'flex';
  };

  window.closeDetailModal = function() {
    document.getElementById('detailModal').style.display = 'none';
  };

  window.approveCurrent = function() {
    if (!currentSelectedId) return;
    updateParticipantStatus(currentSelectedId, 'PAID');
    alert(`Status pendaftaran ${currentSelectedId} berhasil diverifikasi menjadi LUNAS!`);
    closeDetailModal();
    renderTable();
  };

  // CSV Export
  window.exportToCSV = function() {
    const list = getStore();
    const headers = ['ID Peserta', 'Nama', 'NIK', 'WhatsApp', 'Email', 'Gender', 'Alamat', 'Paket', 'Ukuran Jersey', 'Total Bayar', 'Metode', 'Status Bayar', 'Klaim RPC'];
    const rows = list.map(p => [
      p.id,
      `"${p.nama}"`,
      `'${p.nik}`,
      `'${p.whatsapp}`,
      p.email,
      p.gender,
      `"${p.alamat}"`,
      p.paket,
      p.ukuranJersey,
      p.totalBayar,
      p.metodeBayar,
      p.status,
      p.racepackClaimed ? 'SUDAH' : 'BELUM'
    ]);

    const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement('a');
    link.setAttribute('href', encodedUri);
    link.setAttribute('download', `peserta_baznas_funwalk_${new Date().toISOString().slice(0,10)}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  renderTable();
</script>
