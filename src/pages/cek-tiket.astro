---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cek Status Pendaftaran & E-Ticket — BAZNAS Fun Walk 2026" activePage="cek-tiket">
  <section class="sec sec--tint page-sec">
    <div class="wrap" style="max-width:820px">
      <div style="text-align:center; margin-bottom:36px">
        <p class="kicker">Layanan Mandiri Peserta</p>
        <h1>Cek Status Pendaftaran & E-Ticket</h1>
        <p class="lede" style="margin:0 auto">
          Masukkan Kode Registrasi (contoh: <b>BFW26-0001</b>) atau Nomor WhatsApp yang Anda daftarkan.
        </p>
      </div>

      <!-- Search Box -->
      <div class="card-clean search-box">
        <form id="searchTicketForm">
          <div class="search-input-group">
            <div class="input-wrapper">
              <span class="search-icon"></span>
              <input 
                type="text" 
                id="searchKeyword" 
                placeholder="Masukkan Kode Registrasi atau No. WhatsApp (08...)" 
                required
              />
            </div>
            <button type="submit" class="btn btn-leaf btn-lg" id="searchBtn">
              <span>Cari Tiket</span>
            </button>
          </div>
          <div class="search-hints">
            <span>Contoh pencarian cepat:</span>
            <button type="button" class="hint-btn" onclick="quickSearch('BFW26-0001')">BFW26-0001</button>
            <button type="button" class="hint-btn" onclick="quickSearch('BFW26-0002')">BFW26-0002</button>
            <button type="button" class="hint-btn" onclick="quickSearch('081223456781')">081223456781</button>
          </div>
        </form>
      </div>

      <!-- Result Not Found -->
      <div class="card-clean not-found-box" id="notFoundBox" style="display:none">
        <div class="nf-icon"></div>
        <h3>Data Tiket Tidak Ditemukan</h3>
        <p class="hint">Pastikan Anda memasukkan kode registrasi yang benar atau nomor WhatsApp aktif saat mendaftar.</p>
        <div style="margin-top:16px">
          <a href="/daftar" class="btn btn-sun btn-sm">Daftar Sekarang</a>
        </div>
      </div>

      <!-- E-Ticket Card -->
      <div class="e-ticket-container" id="ticketResultBox" style="display:none">
        <div class="e-ticket-card">
          <!-- Top Perforated Stripe -->
          <div class="ticket-header">
            <div class="th-brand">
              <img src="/assets/logo-baznas.png" alt="BAZNAS Kab. Bandung" class="th-logo" width="40" height="40">
              <div>
                <div class="th-title">BAZNAS FUN WALK 2026</div>
                <div class="th-sub">Healthy and Charity · 11 Oktober 2026 · Soreang</div>
              </div>
            </div>
            <div class="th-badge-box">
              <span class="badge badge--success" id="ticketStatusBadge">LUNAS / VERIFIED</span>
            </div>
          </div>

          <!-- Ticket Content -->
          <div class="ticket-body">
            <div class="ticket-qr-col">
              <div class="qr-frame">
                <!-- Vector QR representation -->
                <svg width="150" height="150" viewBox="0 0 100 100" fill="currentColor">
                  <rect x="5" y="5" width="30" height="30" fill="none" stroke="currentColor" stroke-width="6"/>
                  <rect x="13" y="13" width="14" height="14" fill="currentColor"/>
                  <rect x="65" y="5" width="30" height="30" fill="none" stroke="currentColor" stroke-width="6"/>
                  <rect x="73" y="13" width="14" height="14" fill="currentColor"/>
                  <rect x="5" y="65" width="30" height="30" fill="none" stroke="currentColor" stroke-width="6"/>
                  <rect x="13" y="73" width="14" height="14" fill="currentColor"/>
                  <rect x="42" y="10" width="8" height="20" fill="currentColor"/>
                  <rect x="42" y="42" width="16" height="16" fill="currentColor"/>
                  <rect x="65" y="42" width="20" height="8" fill="currentColor"/>
                  <rect x="70" y="65" width="20" height="20" fill="currentColor"/>
                  <rect x="42" y="70" width="12" height="15" fill="currentColor"/>
                </svg>
                <div class="qr-id-text" id="tRegId">BFW26-0001</div>
              </div>
              <div class="qr-notice">Tunjukkan barcode ini saat pengambilan race pack</div>
            </div>

            <div class="ticket-info-col">
              <div class="info-group">
                <span class="lbl">Nama Lengkap Peserta:</span>
                <h3 class="val-nama" id="tNama">Ahmad Fauzi Ridwan</h3>
              </div>

              <div class="info-grid">
                <div>
                  <span class="lbl">Kategori Paket:</span>
                  <b id="tPaket">Charity Pack 5K</b>
                </div>
                <div>
                  <span class="lbl">Ukuran Jersey:</span>
                  <b class="jersey-pill" id="tJersey">L (Sedang)</b>
                </div>
                <div>
                  <span class="lbl">Nomor WhatsApp:</span>
                  <b id="tWhatsapp">081223456781</b>
                </div>
                <div>
                  <span class="lbl">Status Race Pack:</span>
                  <b id="tRpcStatus" style="color:var(--leaf)">Belum Diambil</b>
                </div>
              </div>

              <div class="ticket-address-box">
                <span class="lbl">Alamat Domisili:</span>
                <p id="tAlamat">Jl. Raya Soreang No. 45, Soreang, Kab. Bandung</p>
              </div>
            </div>
          </div>

          <!-- Bottom Notice -->
          <div class="ticket-footer">
            <div class="tf-notice">
              <b>Pengambilan Race Pack (RPC):</b> 8–10 Oktober 2026 di Lobby Gedung Budaya Sabilulungan, Soreang. Bawa E-Ticket ini dan KTP asli/salinan.
            </div>
            <div class="tf-actions">
              <button type="button" class="btn btn-sun btn-sm" onclick="window.print()">
                <span>Cetak E-Ticket</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-sec {
    min-height: 80vh;
  }

  .search-box {
    padding: 28px;
    margin-bottom: 28px;
    box-shadow: var(--shadow-md);
  }

  .search-input-group {
    display: flex;
    gap: 12px;
  }

  .input-wrapper {
    position: relative;
    flex: 1;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.2rem;
    color: var(--grey);
  }

  .input-wrapper input {
    padding-left: 48px;
    height: 52px;
    font-size: 1.05rem;
  }

  .search-hints {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-size: 0.85rem;
    color: var(--grey);
    flex-wrap: wrap;
  }

  .hint-btn {
    background: var(--paper-2);
    border: 1px solid var(--line);
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--leaf);
    cursor: pointer;
  }

  .hint-btn:hover {
    background: var(--leaf);
    color: #FFFFFF;
  }

  .not-found-box {
    text-align: center;
    padding: 36px;
  }

  .nf-icon {
    font-size: 2.5rem;
    margin-bottom: 8px;
  }

  /* E-Ticket Card */
  .e-ticket-container {
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .e-ticket-card {
    background: #FFFFFF;
    border: 2px solid var(--ink);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .ticket-header {
    background: var(--ink);
    color: #FFFFFF;
    padding: 18px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .th-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .th-logo {
    background: #FFFFFF;
    padding: 3px;
    border-radius: 6px;
  }

  .th-title {
    font-family: 'Baloo 2', sans-serif;
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1.1;
  }

  .th-sub {
    font-size: 0.78rem;
    color: var(--lime);
  }

  .ticket-body {
    display: flex;
    gap: 28px;
    padding: 28px;
    align-items: center;
  }

  .ticket-qr-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex-shrink: 0;
    width: 200px;
  }

  .qr-frame {
    background: #FFFFFF;
    border: 2px solid var(--ink);
    border-radius: var(--r-md);
    padding: 14px;
    color: var(--ink);
    display: inline-block;
  }

  .qr-id-text {
    font-family: 'Baloo 2', sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--leaf);
    margin-top: 6px;
    letter-spacing: 0.05em;
  }

  .qr-notice {
    font-size: 0.76rem;
    color: var(--grey);
    margin-top: 8px;
    line-height: 1.3;
  }

  .ticket-info-col {
    flex: 1;
  }

  .info-group {
    margin-bottom: 16px;
  }

  .lbl {
    display: block;
    font-size: 0.76rem;
    color: var(--grey);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 2px;
  }

  .val-nama {
    color: var(--ink);
    font-size: 1.45rem;
    line-height: 1.15;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 16px;
    background: var(--paper-2);
    padding: 14px;
    border-radius: var(--r-sm);
  }

  .info-grid b {
    font-size: 0.95rem;
    color: var(--ink);
  }

  .jersey-pill {
    display: inline-block;
    background: var(--leaf);
    color: #FFFFFF;
    padding: 2px 10px;
    border-radius: 99px;
    font-size: 0.85rem;
  }

  .ticket-address-box {
    font-size: 0.88rem;
    color: var(--grey-d);
  }

  .ticket-address-box p {
    margin: 0;
  }

  .ticket-footer {
    background: var(--paper-2);
    border-top: 1px dashed var(--line);
    padding: 14px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .tf-notice {
    font-size: 0.82rem;
    color: var(--grey-d);
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .search-input-group {
      flex-direction: column;
    }
    .ticket-body {
      flex-direction: column;
    }
    .ticket-footer {
      flex-direction: column;
      text-align: center;
    }
  }

  @media print {
    header, footer, .search-box, .kicker, .page-header {
      display: none !important;
    }
    .e-ticket-card {
      border: 1px solid #000;
      box-shadow: none;
    }
  }
</style>

<script>
  import { getStore } from '../lib/store.js';

  // Check URL query parameter
  const urlParams = new URLSearchParams(window.location.search);
  const idFromUrl = urlParams.get('id');
  if (idFromUrl) {
    const input = document.getElementById('searchKeyword');
    if (input) input.value = idFromUrl;
    performSearch(idFromUrl);
  }

  window.quickSearch = function(val) {
    const input = document.getElementById('searchKeyword');
    if (input) input.value = val;
    performSearch(val);
  };

  const form = document.getElementById('searchTicketForm');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const kw = document.getElementById('searchKeyword')?.value?.trim();
      if (kw) performSearch(kw);
    });
  }

  function performSearch(kw) {
    const participants = getStore();
    const cleanKw = kw.toLowerCase().trim();

    const found = participants.find(p => 
      p.id.toLowerCase() === cleanKw ||
      p.whatsapp.toLowerCase().replace(/[^0-9]/g, '') === cleanKw.replace(/[^0-9]/g, '') ||
      p.email.toLowerCase() === cleanKw
    );

    const notFoundEl = document.getElementById('notFoundBox');
    const resultEl = document.getElementById('ticketResultBox');

    if (!found) {
      if (notFoundEl) notFoundEl.style.display = 'block';
      if (resultEl) resultEl.style.display = 'none';
      return;
    }

    if (notFoundEl) notFoundEl.style.display = 'none';
    if (resultEl) resultEl.style.display = 'block';

    // Populate data
    document.getElementById('tRegId').textContent = found.id;
    document.getElementById('tNama').textContent = found.nama;
    document.getElementById('tPaket').textContent = found.paketNama;
    document.getElementById('tJersey').textContent = `Ukuran ${found.ukuranJersey}`;
    document.getElementById('tWhatsapp').textContent = found.whatsapp;
    document.getElementById('tAlamat').textContent = found.alamat;

    const badge = document.getElementById('ticketStatusBadge');
    if (badge) {
      if (found.status === 'PAID') {
        badge.className = 'badge badge--success';
        badge.textContent = 'LUNAS / VERIFIED';
      } else {
        badge.className = 'badge badge--warning';
        badge.textContent = 'MENUNGGU VERIFIKASI';
      }
    }

    const rpcStatus = document.getElementById('tRpcStatus');
    if (rpcStatus) {
      if (found.racepackClaimed) {
        rpcStatus.style.color = '#127A34';
        rpcStatus.textContent = `✓ Sudah Diambil (${found.claimedBy || 'Panitia'})`;
      } else {
        rpcStatus.style.color = '#B26A00';
        rpcStatus.textContent = 'Belum Diambil (Ambil di RPC 8–10 Okt)';
      }
    }

    resultEl.scrollIntoView({ behavior: 'smooth' });
  }
</script>
