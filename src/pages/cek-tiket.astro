---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cek Status Pendaftaran & E-Ticket — BAZNAS Fun Walk 2026" activePage="cek-tiket">
  <section class="sec sec--tint page-sec">
    <div class="wrap" style="max-width:820px">
      <div style="text-align:center; margin-bottom:36px">
        <p class="kicker">Layanan Mandiri Peserta</p>
        <h1>Cek Status Pendaftaran & E-Ticket</h1>
        <p class="lede" style="margin:0 auto">
          Masukkan Kode Registrasi (contoh: <b>BFW26-0001</b>) atau Nomor WhatsApp yang Anda daftarkan.
        </p>
      </div>

      <!-- Search Box -->
      <div class="card-clean search-box">
        <form id="searchTicketForm">
          <div class="search-input-group">
            <div class="input-wrapper">
              <span class="search-icon"></span>
              <input 
                type="text" 
                id="searchKeyword" 
                placeholder="Masukkan Kode Registrasi atau No. WhatsApp (08...)" 
                required
              />
            </div>
            <button type="submit" class="btn btn-leaf btn-lg" id="searchBtn">
              <span>Cari Tiket</span>
            </button>
          </div>
          <div class="search-hints">
            <span>Contoh pencarian cepat:</span>
            <button type="button" class="hint-btn" onclick="quickSearch('BFW26-0001')">BFW26-0001</button>
            <button type="button" class="hint-btn" onclick="quickSearch('BFW26-0002')">BFW26-0002</button>
            <button type="button" class="hint-btn" onclick="quickSearch('081223456781')">081223456781</button>
          </div>
        </form>
      </div>

      <!-- Result Not Found -->
      <div class="card-clean not-found-box" id="notFoundBox" style="display:none">
        <div class="nf-icon"></div>
        <h3>Data Tiket Tidak Ditemukan</h3>
        <p class="hint">Pastikan Anda memasukkan kode registrasi yang benar atau nomor WhatsApp aktif saat mendaftar.</p>
        <div style="margin-top:16px">
          <a href="/daftar" class="btn btn-sun btn-sm">Daftar Sekarang</a>
        </div>
      </div>

      <!-- E-Ticket Card -->
      <div class="e-ticket-container" id="ticketResultBox" style="display:none">
        <div class="e-ticket-card">
          <!-- Top Perforated Stripe -->
          <div class="ticket-header">
            <div class="th-brand">
              <img src="/assets/logo-baznas.png" alt="BAZNAS Kab. Bandung" class="th-logo" width="40" height="40">
              <div>
                <div class="th-title">BAZNAS FUN WALK 2026</div>
                <div class="th-sub">Healthy and Charity · 21 November 2026 · Soreang</div>
              </div>
            </div>
            <div class="th-badge-box">
              <span class="badge badge--success" id="ticketStatusBadge">LUNAS / VERIFIED</span>
            </div>
          </div>

          <!-- Ticket Content -->
            <div class="ticket-qr-col">
              <div class="qr-frame">
                <!-- Real Scannable QR Code -->
                <img id="ticketQrImage" src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=BFW26-0001&margin=6" alt="QR Code Tiket" width="140" height="140" style="display:block; border-radius:6px; background:#fff; margin:0 auto;" />
                <div class="qr-id-text" id="tRegId">BFW26-0001</div>
              </div>
              <div class="qr-notice">Tunjukkan barcode ini saat pengambilan race pack</div>
            </div>

            <div class="ticket-info-col">
              <div class="info-group">
                <span class="lbl">Nama Lengkap Peserta:</span>
                <h3 class="val-nama" id="tNama">Ahmad Fauzi Ridwan</h3>
                <div id="tNama2Row" style="display:none; margin-top:4px; font-size:0.95rem; color:var(--moss)">
                  <span>Peserta Ke-2: </span><b id="tNama2">-</b>
                </div>
              </div>

              <div class="info-grid">
                <div>
                  <span class="lbl">Kategori Paket:</span>
                  <b id="tPaket">Regular Pack 5K</b>
                </div>
                <div>
                  <span class="lbl">Ukuran Jersey:</span>
                  <b class="jersey-pill" id="tJersey">L</b>
                </div>
                <div>
                  <span class="lbl">Nomor WhatsApp:</span>
                  <b id="tWhatsapp">081223456781</b>
                </div>
                <div>
                  <span class="lbl">Status Race Pack:</span>
                  <b id="tRpcStatus" style="color:var(--leaf)">Belum Diambil</b>
                </div>
              </div>

              <!-- Thank You Card / Payment Notice -->
              <div class="thank-you-card" id="ticketThankYouCard" style="background:linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%); border:1.5px solid #86EFAC; border-radius:var(--r-md); padding:16px 20px; margin-top:16px;">
                <div style="display:flex; align-items:flex-start; gap:12px;">
                  <div style="background:var(--leaf); color:#fff; width:36px; height:36px; border-radius:50%; display:grid; place-items:center; flex-shrink:0; font-size:1.1rem; font-weight:800;">✓</div>
                  <div>
                    <b style="color:var(--leaf); font-size:1.02rem; display:block; margin-bottom:4px; font-family:'Baloo 2', sans-serif;">Jazakumullah Khairan Katsiran! 🌟</b>
                    <p style="margin:0; font-size:0.86rem; color:#14532D; line-height:1.5;">
                      Terima kasih sebesar-besarnya atas partisipasi dan kepedulian Anda dalam <b>BAZNAS Fun Walk 2026</b>. Setiap langkah kaki dan kebaikan donasi yang Anda titipkan menjadi berkah nyata yang memberdayakan ribuan mustahik di Kabupaten Bandung. Sampai jumpa di garis start!
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Notice -->
          <div class="ticket-footer">
            <div class="tf-notice">
              <b>Pengambilan Race Pack (RPC):</b> 19–20 November 2026 di Jl. Terusan Alfathu KM 17 No.3 Desa Pamekaran, Soreang 40377 (Kantor BAZNAS Kabupaten Bandung Belakang Gedung Ormas). Tunjukkan E-Ticket digital atau cetak ini kepada panitia meja.
            </div>
            <div class="tf-actions" style="display:flex; gap:10px; flex-wrap:wrap">
              <button type="button" class="btn btn-leaf btn-sm" id="downloadTicketBtn" onclick="downloadTicketImage()">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>Unduh E-Ticket</span>
              </button>
              <button type="button" class="btn btn-sun btn-sm" onclick="window.print()">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                <span>Cetak E-Ticket</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-sec {
    min-height: 80vh;
  }

  .search-box {
    padding: 28px;
    margin-bottom: 28px;
    box-shadow: var(--shadow-md);
  }

  .search-input-group {
    display: flex;
    gap: 12px;
  }

  .input-wrapper {
    position: relative;
    flex: 1;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.2rem;
    color: var(--grey);
  }

  .input-wrapper input {
    padding-left: 48px;
    height: 52px;
    font-size: 1.05rem;
  }

  .search-hints {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-size: 0.85rem;
    color: var(--grey);
    flex-wrap: wrap;
  }

  .hint-btn {
    background: var(--paper-2);
    border: 1px solid var(--line);
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--leaf);
    cursor: pointer;
  }

  .hint-btn:hover {
    background: var(--leaf);
    color: #FFFFFF;
  }

  .not-found-box {
    text-align: center;
    padding: 36px;
  }

  .nf-icon {
    font-size: 2.5rem;
    margin-bottom: 8px;
  }

  /* E-Ticket Card */
  .e-ticket-container {
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .e-ticket-card {
    background: #FFFFFF;
    border: 2px solid var(--ink);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .ticket-header {
    background: var(--ink);
    color: #FFFFFF;
    padding: 18px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .th-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .th-logo {
    height: 38px;
    width: auto;
    object-fit: contain;
  }

  .th-title {
    font-family: 'Baloo 2', sans-serif;
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1.1;
  }

  .th-sub {
    font-size: 0.78rem;
    color: var(--lime);
  }

  .ticket-body {
    display: flex;
    gap: 28px;
    padding: 28px;
    align-items: center;
  }

  .ticket-qr-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex-shrink: 0;
    width: 200px;
  }

  .qr-frame {
    background: #FFFFFF;
    border: 2px solid var(--ink);
    border-radius: var(--r-md);
    padding: 14px;
    color: var(--ink);
    display: inline-block;
  }

  .qr-id-text {
    font-family: 'Baloo 2', sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--leaf);
    margin-top: 6px;
    letter-spacing: 0.05em;
  }

  .qr-notice {
    font-size: 0.76rem;
    color: var(--grey);
    margin-top: 8px;
    line-height: 1.3;
  }

  .ticket-info-col {
    flex: 1;
  }

  .info-group {
    margin-bottom: 16px;
  }

  .lbl {
    display: block;
    font-size: 0.76rem;
    color: var(--grey);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 2px;
  }

  .val-nama {
    color: var(--ink);
    font-size: 1.45rem;
    line-height: 1.15;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 16px;
    background: var(--paper-2);
    padding: 14px;
    border-radius: var(--r-sm);
  }

  .info-grid b {
    font-size: 0.95rem;
    color: var(--ink);
  }

  .jersey-pill {
    display: inline-block;
    background: var(--leaf);
    color: #FFFFFF;
    padding: 2px 10px;
    border-radius: 99px;
    font-size: 0.85rem;
  }

  .ticket-address-box {
    font-size: 0.88rem;
    color: var(--grey-d);
  }

  .ticket-address-box p {
    margin: 0;
  }

  .ticket-footer {
    background: var(--paper-2);
    border-top: 1px dashed var(--line);
    padding: 14px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .tf-notice {
    font-size: 0.82rem;
    color: var(--grey-d);
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .search-input-group {
      flex-direction: column;
    }
    .ticket-body {
      flex-direction: column;
    }
    .ticket-footer {
      flex-direction: column;
      text-align: center;
    }
  }

  @media print {
    header, footer, .search-box, .kicker, .page-header {
      display: none !important;
    }
    .e-ticket-card {
      border: 1px solid #000;
      box-shadow: none;
    }
  }
</style>

<script>
  import { getStore, fetchParticipantById } from '../lib/store.js';

  // Check URL query parameter
  const urlParams = new URLSearchParams(window.location.search);
  const idFromUrl = urlParams.get('id');
  if (idFromUrl) {
    const input = document.getElementById('searchKeyword') as HTMLInputElement | null;
    if (input) input.value = idFromUrl;
    performSearch(idFromUrl);
  }

  (window as any).quickSearch = function(val: string) {
    const input = document.getElementById('searchKeyword') as HTMLInputElement | null;
    if (input) input.value = val;
    performSearch(val);
  };

  const form = document.getElementById('searchTicketForm');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const kw = (document.getElementById('searchKeyword') as HTMLInputElement | null)?.value?.trim();
      if (kw) performSearch(kw);
    });
  }

  async function performSearch(kw) {
    // Cari langsung ke server backend dengan fallback ke cache lokal
    const found = await fetchParticipantById(kw);

    const notFoundEl = document.getElementById('notFoundBox');
    const resultEl = document.getElementById('ticketResultBox');

    if (!found) {
      if (notFoundEl) notFoundEl.style.display = 'block';
      if (resultEl) resultEl.style.display = 'none';
      return;
    }

    if (notFoundEl) notFoundEl.style.display = 'none';
    if (resultEl) resultEl.style.display = 'block';

    // Populate data
    const elRegId = document.getElementById('tRegId');
    if (elRegId) elRegId.textContent = found.id;
    const qrImg = document.getElementById('ticketQrImage') as HTMLImageElement | null;
    if (qrImg) {
      qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(found.id)}&margin=6`;
    }
    const elNama = document.getElementById('tNama');
    if (elNama) elNama.textContent = found.nama;
    const elPaket = document.getElementById('tPaket');
    if (elPaket) elPaket.textContent = found.paketNama;
    
    // Family pack member 2
    const tNama2Row = document.getElementById('tNama2Row');
    const tNama2 = document.getElementById('tNama2');
    if (tNama2Row && tNama2) {
      if (found.namaPeserta2 && found.namaPeserta2 !== '-') {
        tNama2Row.style.display = 'block';
        tNama2.textContent = found.namaPeserta2;
      } else {
        tNama2Row.style.display = 'none';
      }
    }

    // Jersey display
    const jerseyEl = document.getElementById('tJersey');
    if (jerseyEl) {
      if (found.paket === 'donasi' || found.ukuranJersey === '-') {
        jerseyEl.textContent = 'Tanpa Jersey';
      } else if (found.ukuranJersey2 && found.ukuranJersey2 !== '-') {
        jerseyEl.textContent = `P1: ${found.ukuranJersey} | P2: ${found.ukuranJersey2}`;
      } else {
        jerseyEl.textContent = `Ukuran ${found.ukuranJersey}`;
      }
    }

    const tWhatsapp = document.getElementById('tWhatsapp');
    if (tWhatsapp) tWhatsapp.textContent = found.whatsapp;
    const tAlamat = document.getElementById('tAlamat');
    if (tAlamat) tAlamat.textContent = found.alamat || 'Kabupaten Bandung';

    const badge = document.getElementById('ticketStatusBadge');
    const thankYouCard = document.getElementById('ticketThankYouCard');
    if (badge) {
      if (found.status === 'PAID') {
        badge.className = 'badge badge--success';
        badge.textContent = 'LUNAS / VERIFIED';
        if (thankYouCard) {
          thankYouCard.style.background = 'linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%)';
          thankYouCard.style.borderColor = '#86EFAC';
          thankYouCard.innerHTML = `
            <div style="display:flex; align-items:flex-start; gap:12px;">
              <div style="background:var(--leaf); color:#fff; width:36px; height:36px; border-radius:50%; display:grid; place-items:center; flex-shrink:0; font-size:1.1rem; font-weight:800;">✓</div>
              <div>
                <b style="color:var(--leaf); font-size:1.02rem; display:block; margin-bottom:4px; font-family:'Baloo 2', sans-serif;">Jazakumullah Khairan Katsiran! 🌟</b>
                <p style="margin:0; font-size:0.86rem; color:#14532D; line-height:1.5;">
                  Terima kasih sebesar-besarnya atas partisipasi dan kepedulian Anda dalam <b>BAZNAS Fun Walk 2026</b>. Setiap langkah kaki dan kebaikan donasi yang Anda titipkan menjadi berkah nyata yang memberdayakan ribuan mustahik di Kabupaten Bandung. Sampai jumpa di garis start!
                </p>
              </div>
            </div>
          `;
        }
      } else {
        badge.className = 'badge badge--warning';
        badge.textContent = 'MENUNGGU PEMBAYARAN';
        if (thankYouCard) {
          thankYouCard.style.background = 'linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%)';
          thankYouCard.style.borderColor = '#FCD34D';
          thankYouCard.innerHTML = `
            <b style="color:#92400E; font-size:0.95rem; display:block; margin-bottom:4px;">⚠️ Status: Menunggu Pembayaran</b>
            <p style="margin:0; font-size:0.84rem; color:#78350F; line-height:1.45;">
              Pesanan Anda tercatat dengan status <b>Menunggu Pembayaran</b>. E-Ticket resmi baru dapat digunakan untuk pengambilan Race Pack setelah pembayaran terkonfirmasi LUNAS.
            </p>
          `;
        }
      }
    }

    const rpcStatus = document.getElementById('tRpcStatus');
    if (rpcStatus) {
      if (found.racepackClaimed) {
        rpcStatus.style.color = '#127A34';
        rpcStatus.textContent = `✓ Sudah Diambil (${found.claimedBy || 'Panitia'})`;
      } else {
        rpcStatus.style.color = '#B26A00';
        rpcStatus.textContent = 'Belum Diambil (Ambil di RPC 19–20 Nov @ Kantor BAZNAS Kab. Bandung)';
      }
    }

    if (resultEl) {
      resultEl.scrollIntoView({ behavior: 'smooth' });
    }
  }

  // Fungsi Unduh E-Ticket dalam bentuk Gambar (Canvas PNG)
  window.downloadTicketImage = function() {
    const status = document.getElementById('ticketStatusBadge')?.textContent || 'LUNAS';
    if (!status.includes('LUNAS')) {
      alert('E-Ticket resmi dengan barcode valid hanya dapat diunduh setelah status pembayaran LUNAS.\n\nSilakan selesaikan pembayaran registrasi Anda terlebih dahulu.');
      return;
    }

    const regId = document.getElementById('tRegId')?.textContent || 'TIKET';
    const nama = document.getElementById('tNama')?.textContent || 'Peserta';
    const paket = document.getElementById('tPaket')?.textContent || '-';
    const jersey = document.getElementById('tJersey')?.textContent || '-';
    const wa = document.getElementById('tWhatsapp')?.textContent || '-';

    // Buat canvas resolusi tinggi (HD)
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    const width = 1000;
    const height = 620;
    canvas.width = width;
    canvas.height = height;

    // Background Canvas
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(0, 0, width, height);

    // Header Background (Dark Green / Forest)
    ctx.fillStyle = '#062E16';
    ctx.fillRect(0, 0, width, 110);

    // Header Accent Line (Gold)
    ctx.fillStyle = '#C59A27';
    ctx.fillRect(0, 105, width, 5);

    // Header Text
    ctx.fillStyle = '#FFFFFF';
    ctx.font = 'bold 30px system-ui, -apple-system, sans-serif';
    ctx.fillText('BAZNAS FUN WALK 2026', 40, 52);

    ctx.fillStyle = '#A3E635';
    ctx.font = '500 17px system-ui, -apple-system, sans-serif';
    ctx.fillText('Healthy & Charity  •  21 November 2026  •  DOME Bale Rame, Soreang', 40, 84);

    // Status Badge Top Right
    ctx.fillStyle = '#166534';
    ctx.beginPath();
    ctx.roundRect(width - 240, 36, 200, 38, [8]);
    ctx.fill();
    ctx.fillStyle = '#DCFCE7';
    ctx.font = 'bold 15px system-ui, -apple-system, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('✓ ' + status, width - 140, 61);
    ctx.textAlign = 'left';

    // Left Box: QR & ID Container
    ctx.fillStyle = '#F8FAFC';
    ctx.strokeStyle = '#E2E8F0';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.roundRect(40, 140, 240, 280, [12]);
    ctx.fill();
    ctx.stroke();

    // Draw Simulated Clean Barcode / QR Box
    ctx.fillStyle = '#062E16';
    // Top-left finder
    ctx.fillRect(75, 165, 45, 45);
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(83, 173, 29, 29);
    ctx.fillStyle = '#062E16';
    ctx.fillRect(90, 180, 15, 15);

    // Top-right finder
    ctx.fillRect(195, 165, 45, 45);
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(203, 173, 29, 29);
    ctx.fillStyle = '#062E16';
    ctx.fillRect(210, 180, 15, 15);

    // Bottom-left finder
    ctx.fillRect(75, 275, 45, 45);
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(83, 283, 29, 29);
    ctx.fillStyle = '#062E16';
    ctx.fillRect(90, 290, 15, 15);

    // Center data points
    ctx.fillRect(145, 175, 25, 25);
    ctx.fillRect(145, 220, 25, 30);
    ctx.fillRect(195, 235, 20, 15);
    ctx.fillRect(180, 275, 35, 20);
    ctx.fillRect(145, 275, 20, 45);
    ctx.fillRect(220, 295, 20, 25);

    // Reg ID Text Badge
    ctx.fillStyle = '#0F172A';
    ctx.font = 'bold 18px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(regId, 160, 365);

    ctx.fillStyle = '#64748B';
    ctx.font = '12px system-ui, -apple-system, sans-serif';
    ctx.fillText('Tunjukkan barcode ini di meja RPC', 160, 395);
    ctx.textAlign = 'left';

    // Right Column: Participant Details
    ctx.fillStyle = '#64748B';
    ctx.font = '13px system-ui, -apple-system, sans-serif';
    ctx.fillText('NAMA LENGKAP PESERTA:', 320, 165);

    ctx.fillStyle = '#0F172A';
    ctx.font = 'bold 26px system-ui, -apple-system, sans-serif';
    ctx.fillText(nama, 320, 200);

    // Detail Grid
    // Col 1: Kategori Paket & Jersey
    ctx.fillStyle = '#64748B';
    ctx.font = '13px system-ui, -apple-system, sans-serif';
    ctx.fillText('KATEGORI PAKET:', 320, 245);
    ctx.fillStyle = '#0F172A';
    ctx.font = 'bold 18px system-ui, -apple-system, sans-serif';
    ctx.fillText(paket, 320, 272);

    ctx.fillStyle = '#64748B';
    ctx.font = '13px system-ui, -apple-system, sans-serif';
