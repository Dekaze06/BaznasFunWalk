<script>
  import { saveParticipant, getStockSummary } from '../lib/store.js';
  import { formatRupiah } from '../lib/utils.js';

  // Global declarations for TypeScript linter in IDE
  declare global {
    interface Window {
      nextStep?: (step: number) => void;
      prevStep?: (step: number) => void;
      validateStep2?: () => void;
      validateStep3?: () => void;
      downloadTicketImageFromModal?: () => void;
      snap?: any;
    }
  }

  let currentStep = 1;
  let selectedPaket = 'reguler';
  let selectedSize = 'L';
  let selectedSize2 = 'M';
  let selectedPayment = 'QRIS Instan';
  let additionalDonasi = 0;
  let currentParticipantData: any = null;

  // Option Cards
  const optDonasi = document.getElementById('optDonasi');
  const optReguler = document.getElementById('optReguler');
  const optFamily = document.getElementById('optFamily');

  if (optDonasi) optDonasi.addEventListener('click', () => selectPackage('donasi'));
  if (optReguler) optReguler.addEventListener('click', () => selectPackage('reguler'));
  if (optFamily) optFamily.addEventListener('click', () => selectPackage('family'));

  function selectPackage(pkg: string) {
    selectedPaket = pkg;
    if (optDonasi) optDonasi.classList.toggle('active', pkg === 'donasi');
    if (optReguler) optReguler.classList.toggle('active', pkg === 'reguler');
    if (optFamily) optFamily.classList.toggle('active', pkg === 'family');

    const input = document.querySelector(`input[name="paket"][value="${pkg}"]`) as HTMLInputElement | null;
    if (input) input.checked = true;

    // Toggle Family Member fields in Step 2 & 3
    const famRow = document.getElementById('familyMemberRow');
    const famJersey = document.getElementById('familySecondJerseyBox');
    if (famRow) famRow.style.display = pkg === 'family' ? 'block' : 'none';
    if (famJersey) famJersey.style.display = pkg === 'family' ? 'block' : 'none';

    // Toggle Donasi Only notice in Step 3
    const donasiNotice = document.getElementById('donasiOnlyJerseyNotice');
    const regJerseySec = document.getElementById('regularJerseySection');
    if (donasiNotice && regJerseySec) {
      if (pkg === 'donasi') {
        donasiNotice.style.display = 'block';
        regJerseySec.style.display = 'none';
      } else {
        donasiNotice.style.display = 'none';
        regJerseySec.style.display = 'block';
      }
    }
  }

  // Additional Donation Chips
  const donChips = document.querySelectorAll('.don-chip');
  const customDonBox = document.getElementById('customDonasiWrap') || document.getElementById('customDonasiBox');
  const customDonInput = document.getElementById('customDonasiInput') as HTMLInputElement | null;

  donChips.forEach(chip => {
    chip.addEventListener('click', () => {
      donChips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');

      const val = chip.getAttribute('data-val');
      if (val === 'custom') {
        if (customDonBox) customDonBox.style.display = 'block';
        if (customDonInput) {
          customDonInput.focus();
          additionalDonasi = parseInt(customDonInput.value || '0', 10) || 0;
        }
      } else {
        if (customDonBox) customDonBox.style.display = 'none';
        additionalDonasi = parseInt(val || '0', 10) || 0;
      }
      updateSummary();
    });
  });

  if (customDonInput) {
    customDonInput.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement | null;
      const val = parseInt(target?.value || '0', 10);
      additionalDonasi = isNaN(val) || val < 0 ? 0 : val;
      updateSummary();
    });
  }

  // Check URL params for pre-selected package, donation, and step
  const urlParams = new URLSearchParams(window.location.search);
  const paramPaket = urlParams.get('paket');
  if (paramPaket && ['donasi', 'reguler', 'family'].includes(paramPaket)) {
    selectPackage(paramPaket);
  } else {
    selectPackage('reguler');
  }

  const paramDonasi = urlParams.get('donasi');
  if (paramDonasi) {
    const dVal = parseInt(paramDonasi, 10);
    if (!isNaN(dVal) && dVal > 0) {
      additionalDonasi = dVal;
      let matched = false;
      donChips.forEach(c => {
        if (c.getAttribute('data-val') === String(dVal)) {
          donChips.forEach(ch => ch.classList.remove('active'));
          c.classList.add('active');
          matched = true;
        }
      });
      if (!matched) {
        donChips.forEach(ch => ch.classList.remove('active'));
        const customChip = document.getElementById('btnCustomDonasi');
        if (customChip) customChip.classList.add('active');
        if (customDonBox) customDonBox.style.display = 'block';
        if (customDonInput) customDonInput.value = String(dVal);
      }
    }
  }

  const paramStep = urlParams.get('step');
  if (paramStep === '2') {
    // Auto advance directly to step 2 (Data Diri)
    setTimeout(() => {
      if (typeof window.nextStep === 'function') {
        window.nextStep(2);
      }
    }, 50);
  }

  // Primary Jersey Card selection
  const primaryJerseyCards = document.querySelectorAll('.jersey-choice-card:not(.jersey-choice-card--sec)');
  primaryJerseyCards.forEach(card => {
    card.addEventListener('click', () => {
      primaryJerseyCards.forEach(c => c.classList.remove('active'));
      card.classList.add('active');
      const radio = card.querySelector('input[type="radio"]') as HTMLInputElement | null;
      if (radio) {
        radio.checked = true;
        selectedSize = radio.value;
      }
    });
  });

  // Secondary Jersey Card selection (Family Pack)
  const secJerseyCards = document.querySelectorAll('.jersey-choice-card--sec');
  secJerseyCards.forEach(card => {
    card.addEventListener('click', () => {
      secJerseyCards.forEach(c => c.classList.remove('active'));
      card.classList.add('active');
      const radio = card.querySelector('input[type="radio"]') as HTMLInputElement | null;
      if (radio) {
        radio.checked = true;
        selectedSize2 = radio.value;
      }
    });
  });

  // Set default primary size active
  const defaultSizeCard = document.getElementById(`cardSize_L`);
  if (defaultSizeCard) {
    defaultSizeCard.classList.add('active');
    const rad = defaultSizeCard.querySelector('input') as HTMLInputElement | null;
    if (rad) rad.checked = true;
  }

  // Set default secondary size active
  const defaultSecCard = document.getElementById(`cardSecSize_M`);
  if (defaultSecCard) {
    defaultSecCard.classList.add('active');
    const rad = defaultSecCard.querySelector('input') as HTMLInputElement | null;
    if (rad) rad.checked = true;
  }

  // Payment method selection
  const payCards = document.querySelectorAll('.pay-method-card');
  payCards.forEach(card => {
    card.addEventListener('click', () => {
      payCards.forEach(c => c.classList.remove('active'));
      card.classList.add('active');
      const radio = card.querySelector('input[type="radio"]') as HTMLInputElement | null;
      if (radio) {
        radio.checked = true;
        selectedPayment = radio.value;
      }
    });
  });

  // Navigation functions
  function nextStep(step: number) {
    const prevEl = document.getElementById(`step${currentStep}`);
    const nextEl = document.getElementById(`step${step}`);
    if (prevEl) prevEl.style.display = 'none';
    if (nextEl) nextEl.style.display = 'block';
    
    const prevPill = document.getElementById(`stepPill${currentStep}`);
    const nextPill = document.getElementById(`stepPill${step}`);
    if (prevPill) {
      prevPill.classList.remove('active');
      prevPill.classList.add('done');
    }
    if (nextPill) nextPill.classList.add('active');

    currentStep = step;
    window.scrollTo({ top: 100, behavior: 'smooth' });

    if (step === 4) {
      updateSummary();
    }
  }
  window.nextStep = nextStep;

  function prevStep(step: number) {
    const prevEl = document.getElementById(`step${currentStep}`);
    const nextEl = document.getElementById(`step${step}`);
    if (prevEl) prevEl.style.display = 'none';
    if (nextEl) nextEl.style.display = 'block';

    const prevPill = document.getElementById(`stepPill${currentStep}`);
    const nextPill = document.getElementById(`stepPill${step}`);
    if (prevPill) prevPill.classList.remove('active');
    if (nextPill) nextPill.classList.add('active');

    currentStep = step;
    window.scrollTo({ top: 100, behavior: 'smooth' });
  }
  window.prevStep = prevStep;

  function validateStep2() {
    const nama = (document.getElementById('nama') as HTMLInputElement)?.value?.trim();
    const wa = (document.getElementById('whatsapp') as HTMLInputElement)?.value?.trim();
    const email = (document.getElementById('email') as HTMLInputElement)?.value?.trim();

    if (!nama || !wa || !email) {
      alert('Harap lengkapi Nama, WhatsApp, dan Email Anda.');
      return;
    }
    if (wa.length < 9) {
      alert('Nomor WhatsApp minimal 10 digit angka.');
      return;
    }
    nextStep(3);
  }
  window.validateStep2 = validateStep2;

  function validateStep3() {
    if (selectedPaket === 'donasi') {
      nextStep(4);
      return;
    }

    const checkedSize = document.querySelector('input[name="ukuranJersey"]:checked') as HTMLInputElement | null;
    if (!checkedSize) {
      alert('Harap pilih ukuran jersey untuk Peserta Utama.');
      return;
    }
    selectedSize = checkedSize.value;

    if (selectedPaket === 'family') {
      const checkedSize2 = document.querySelector('input[name="ukuranJerseySec"]:checked') as HTMLInputElement | null;
      if (!checkedSize2) {
        alert('Harap pilih ukuran jersey untuk Peserta Ke-2 (Family Pack).');
        return;
      }
      selectedSize2 = checkedSize2.value;
    }

    nextStep(4);
  }
  window.validateStep3 = validateStep3;

  function updateSummary() {
    const nama = (document.getElementById('nama') as HTMLInputElement)?.value || '-';
    const nama2 = (document.getElementById('namaPeserta2') as HTMLInputElement)?.value || '';
    const wa = (document.getElementById('whatsapp') as HTMLInputElement)?.value || '-';
    const email = (document.getElementById('email') as HTMLInputElement)?.value || '-';

    const elSumNama = document.getElementById('summaryNama');
    if (elSumNama) elSumNama.textContent = nama;
    const elSumKontak = document.getElementById('summaryKontak');
    if (elSumKontak) elSumKontak.textContent = `${wa} / ${email}`;

    // Family pack member 2 row
    const sumPeserta2Row = document.getElementById('summaryPeserta2Row');
    if (sumPeserta2Row) {
      sumPeserta2Row.style.display = selectedPaket === 'family' ? 'flex' : 'none';
      const sumNama2 = document.getElementById('summaryNama2');
      if (sumNama2) sumNama2.textContent = nama2.trim() ? nama2.trim() : '(Peserta Ke-2)';
    }

    // Size summary
    const elSumSize = document.getElementById('summarySize');
    if (elSumSize) {
      if (selectedPaket === 'donasi') {
        elSumSize.textContent = 'Tanpa Jersey (Donasi Only)';
      } else if (selectedPaket === 'family') {
        elSumSize.textContent = `Peserta 1: ${selectedSize} | Peserta 2: ${selectedSize2}`;
      } else {
        elSumSize.textContent = `Ukuran ${selectedSize}`;
      }
    }

    let basePaketPrice = 80000;
    let baseDonasi = 20000;
    let baseRegFee = 60000;

    const elSumPaket = document.getElementById('summaryPaket');
    const elSumBiaya = document.getElementById('summaryBiayaEvent');
    const elSumDonasi = document.getElementById('summaryDonasiVal');

    if (selectedPaket === 'donasi') {
      basePaketPrice = 50000;
      baseDonasi = 50000;
      baseRegFee = 0;
      if (elSumPaket) elSumPaket.textContent = 'Donasi Only (Rp 50.000)';
      if (elSumBiaya) elSumBiaya.textContent = 'Rp 0';
      if (elSumDonasi) elSumDonasi.textContent = 'Rp 50.000 (100% Donasi ZIS)';
    } else if (selectedPaket === 'family') {
      basePaketPrice = 180000;
      baseDonasi = 20000;
      baseRegFee = 160000;
      if (elSumPaket) elSumPaket.textContent = 'Family Pack 5K (Rp 180.000 untuk 2 orang)';
      if (elSumBiaya) elSumBiaya.textContent = 'Rp 160.000';
      if (elSumDonasi) elSumDonasi.textContent = 'Rp 20.000 (Donasi ZIS)';
    } else {
      basePaketPrice = 80000;
      baseDonasi = 20000;
      baseRegFee = 60000;
      if (elSumPaket) elSumPaket.textContent = 'Regular Pack 5K Early Bird (Rp 80.000)';
      if (elSumBiaya) elSumBiaya.textContent = 'Rp 60.000';
      if (elSumDonasi) elSumDonasi.textContent = 'Rp 20.000 (Donasi ZIS)';
    }

    // Extra Donation Row
    const extraDonRow = document.getElementById('summaryExtraDonasiRow');
    const extraDonVal = document.getElementById('summaryExtraDonasiVal');
    if (extraDonRow && extraDonVal) {
      if (additionalDonasi > 0) {
        extraDonRow.style.display = 'flex';
        extraDonVal.textContent = `+ Rp ${additionalDonasi.toLocaleString('id-ID')}`;
      } else {
        extraDonRow.style.display = 'none';
      }
    }

    const grandTotal = basePaketPrice + additionalDonasi;
    const elSumTotal = document.getElementById('summaryTotal');
    if (elSumTotal) elSumTotal.textContent = `Rp ${grandTotal.toLocaleString('id-ID')}`;
  }

  // Helper to show modal
  function showTicketModal(participantData: any) {
    currentParticipantData = participantData;
    const elId = document.getElementById('modalRegId');
    if (elId) elId.textContent = participantData.id;
    const elNama = document.getElementById('modalNama');
    if (elNama) elNama.textContent = participantData.nama;
    const elPaket = document.getElementById('modalPaket');
    if (elPaket) elPaket.textContent = participantData.paketNama;
    const elSize = document.getElementById('modalSize');
    if (elSize) {
      elSize.textContent = participantData.ukuranJersey !== '-' 
        ? (participantData.ukuranJersey2 && participantData.ukuranJersey2 !== '-' 
            ? `Peserta 1: ${participantData.ukuranJersey} | Peserta 2: ${participantData.ukuranJersey2}` 
            : `Ukuran ${participantData.ukuranJersey}`)
        : 'Tanpa Jersey';
    }
    const elMetode = document.getElementById('modalMetode');
    if (elMetode) elMetode.textContent = participantData.metodeBayar;

    const badge = document.getElementById('modalBadge');
    if (badge) {
      if (participantData.status === 'PAID') {
        badge.className = 'badge badge--success';
        badge.textContent = 'LUNAS / VERIFIED';
      } else {
        badge.className = 'badge badge--warning';
        badge.textContent = 'MENUNGGU PEMBAYARAN';
      }
    }

    const btnView = document.getElementById('modalViewTicketBtn') as HTMLAnchorElement | null;
    if (btnView) btnView.href = `/cek-tiket?id=${participantData.id}`;
    const modal = document.getElementById('successModal');
    if (modal) modal.style.display = 'flex';
  }

  // Unduh E-Ticket Digital High-Res PNG via HTML5 Canvas
  function downloadTicketImageFromModal() {
    const p = currentParticipantData;
    const regId = p?.id || document.getElementById('modalRegId')?.textContent || 'BFW26-0000';
    const nama = p?.nama || document.getElementById('modalNama')?.textContent || '-';
    const paket = p?.paketNama || document.getElementById('modalPaket')?.textContent || '-';
    const jersey = p?.ukuranJersey && p.ukuranJersey !== '-' 
      ? (p.ukuranJersey2 && p.ukuranJersey2 !== '-' ? `${p.ukuranJersey} & ${p.ukuranJersey2}` : p.ukuranJersey)
      : (document.getElementById('modalSize')?.textContent || 'Tanpa Jersey');
    const wa = p?.whatsapp || '-';
    const isPaid = p?.status === 'PAID';
    const status = isPaid ? 'LUNAS / VERIFIED' : 'MENUNGGU PEMBAYARAN';

    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const width = 1000;
    const height = 620;
    canvas.width = width;
    canvas.height = height;

    // Background Canvas
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(0, 0, width, height);

    // Header Background (Dark Green / Forest)
    ctx.fillStyle = '#062E16';
    ctx.fillRect(0, 0, width, 110);

    // Header Accent Line (Gold)
    ctx.fillStyle = '#C59A27';
    ctx.fillRect(0, 105, width, 5);

    // Header Text
    ctx.fillStyle = '#FFFFFF';
    ctx.font = 'bold 30px system-ui, -apple-system, sans-serif';
    ctx.fillText('BAZNAS FUN WALK 2026', 40, 52);

    ctx.fillStyle = '#A3E635';
    ctx.font = '500 17px system-ui, -apple-system, sans-serif';
    ctx.fillText('Healthy & Charity  •  Sabtu, 21 November 2026  •  Gedung Baznas Centre Soreang', 40, 84);

    // Status Badge Top Right
    ctx.fillStyle = isPaid ? '#166534' : '#9A3412';
    ctx.beginPath();
    ctx.roundRect(width - 240, 36, 200, 38, [8]);
    ctx.fill();
    ctx.fillStyle = isPaid ? '#DCFCE7' : '#FFEDD5';
    ctx.font = 'bold 15px system-ui, -apple-system, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(isPaid ? '✓ ' + status : status, width - 140, 61);
    ctx.textAlign = 'left';

    // Left Box: QR & ID Container
    ctx.fillStyle = '#F8FAFC';
    ctx.strokeStyle = '#E2E8F0';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.roundRect(40, 140, 240, 310, [12]);
    ctx.fill();
    ctx.stroke();

    // Draw Simulated Clean Barcode / QR Box
    ctx.fillStyle = '#062E16';
    // Top-left finder
    ctx.fillRect(75, 165, 45, 45);
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(83, 173, 29, 29);
    ctx.fillStyle = '#062E16';
    ctx.fillRect(90, 180, 15, 15);

    // Top-right finder
    ctx.fillRect(195, 165, 45, 45);
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(203, 173, 29, 29);
    ctx.fillStyle = '#062E16';
    ctx.fillRect(210, 180, 15, 15);

    // Bottom-left finder
    ctx.fillRect(75, 275, 45, 45);
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(83, 283, 29, 29);
    ctx.fillStyle = '#062E16';
    ctx.fillRect(90, 290, 15, 15);

    // Center data points
    ctx.fillRect(145, 175, 25, 25);
    ctx.fillRect(145, 220, 25, 30);
    ctx.fillRect(195, 235, 20, 15);
    ctx.fillRect(180, 275, 35, 20);
    ctx.fillRect(145, 275, 20, 45);
    ctx.fillRect(220, 295, 20, 25);

    // Reg ID Text Badge
    ctx.fillStyle = '#0F172A';
    ctx.font = 'bold 18px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(regId, 160, 375);

    ctx.fillStyle = '#64748B';
    ctx.font = '12px system-ui, -apple-system, sans-serif';
    ctx.fillText('Tunjukkan barcode ini di meja RPC', 160, 405);
    ctx.textAlign = 'left';

    // Right Column: Participant Details
    ctx.fillStyle = '#64748B';
    ctx.font = '13px system-ui, -apple-system, sans-serif';
    ctx.fillText('NAMA LENGKAP PESERTA:', 320, 165);

    ctx.fillStyle = '#0F172A';
    ctx.font = 'bold 24px system-ui, -apple-system, sans-serif';
    ctx.fillText(nama, 320, 198);

    // Detail Grid
    // Col 1: Kategori Paket & Jersey
    ctx.fillStyle = '#64748B';
    ctx.font = '13px system-ui, -apple-system, sans-serif';
    ctx.fillText('KATEGORI PAKET:', 320, 240);
    ctx.fillStyle = '#0F172A';
    ctx.font = 'bold 17px system-ui, -apple-system, sans-serif';
    ctx.fillText(paket, 320, 265);

    ctx.fillStyle = '#64748B';
    ctx.font = '13px system-ui, -apple-system, sans-serif';
    ctx.fillText('UKURAN JERSEY:', 320, 315);
    ctx.fillStyle = '#065F46';
    ctx.font = 'bold 17px system-ui, -apple-system, sans-serif';
    ctx.fillText(jersey, 320, 340);

    // Col 2: WhatsApp & Status RPC
    ctx.fillStyle = '#64748B';
    ctx.font = '13px system-ui, -apple-system, sans-serif';
    ctx.fillText('NOMOR WHATSAPP:', 620, 240);
    ctx.fillStyle = '#0F172A';
    ctx.font = 'bold 17px system-ui, -apple-system, sans-serif';
    ctx.fillText(wa, 620, 265);

    ctx.fillStyle = '#64748B';
    ctx.font = '13px system-ui, -apple-system, sans-serif';
    ctx.fillText('PENGAMBILAN RACE PACK:', 620, 315);
    ctx.fillStyle = '#0F172A';
    ctx.font = 'bold 15px system-ui, -apple-system, sans-serif';
    ctx.fillText('19–20 Nov 2026 @ Gedung Baznas Centre', 620, 340);

    // Jazakumullah Khairan Katsiran Card on Canvas
    ctx.fillStyle = '#F0FDF4';
    ctx.strokeStyle = '#86EFAC';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.roundRect(320, 380, 640, 70, [8]);
    ctx.fill();
    ctx.stroke();

    ctx.fillStyle = '#166534';
    ctx.font = 'bold 13px system-ui, -apple-system, sans-serif';
    ctx.fillText('Jazakumullah Khairan Katsiran', 336, 405);
    ctx.fillStyle = '#15803D';
    ctx.font = '12px system-ui, -apple-system, sans-serif';
    ctx.fillText('Terima kasih atas partisipasi dan kepedulian Anda dalam BAZNAS Fun Walk 2026.', 336, 426);
    ctx.fillText('Setiap langkah dan donasi Anda memberdayakan para mustahik di Kabupaten Bandung.', 336, 442);

    // Footer Info Strip
    ctx.fillStyle = '#F1F5F9';
    ctx.fillRect(0, 520, width, 100);
    ctx.strokeStyle = '#E2E8F0';
    ctx.beginPath();
    ctx.moveTo(0, 520);
    ctx.lineTo(width, 520);
    ctx.stroke();

    ctx.fillStyle = '#334155';
    ctx.font = '13px system-ui, -apple-system, sans-serif';
    ctx.fillText('Catatan: Simpan E-Ticket ini di galeri ponsel Anda. E-Ticket ini sah sebagai bukti pendaftaran BAZNAS Fun Walk 2026.', 40, 555);
    ctx.fillText('Lokasi Acara: Gedung Baznas Centre (samping Yogya Soreang), Jl. Raya Soreang, Kab. Bandung', 40, 580);

    // Trigger Download PNG
    const safeName = String(nama).replace(/[^a-zA-Z0-9]/g, '_');
    const fileName = `E-Ticket_${regId}_${safeName}.png`;
    const imageUri = canvas.toDataURL('image/png');

    const link = document.createElement('a');
    link.download = fileName;
    link.href = imageUri;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }
  window.downloadTicketImageFromModal = downloadTicketImageFromModal;

  // Event handler untuk modal size chart
  const btnOpenSize = document.getElementById('btnOpenSizeChart');
  const modalSize = document.getElementById('sizeChartModal');
  const btnCloseSize = document.getElementById('btnCloseSizeChart');
  const btnCloseSizeBtn = document.getElementById('btnCloseSizeChartBtn');
  if (btnOpenSize && modalSize) {
    btnOpenSize.addEventListener('click', () => modalSize.style.display = 'flex');
  }
  if (btnCloseSize && modalSize) {
    btnCloseSize.addEventListener('click', () => modalSize.style.display = 'none');
  }
  if (btnCloseSizeBtn && modalSize) {
    btnCloseSizeBtn.addEventListener('click', () => modalSize.style.display = 'none');
  }
  if (modalSize) {
    modalSize.addEventListener('click', (e) => {
      if (e.target === modalSize) modalSize.style.display = 'none';
    });
  }

  function resetSubmitBtn() {
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<span>Konfirmasi & Bayar Sekarang →</span>';
    }
  }

  // Form Submit
  const form = document.getElementById('regForm');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const agree = (document.getElementById('agreeWaiver') as HTMLInputElement | null)?.checked;
      if (!agree) {
        alert('Anda harus menyetujui Syarat & Ketentuan serta Waiver Kesehatan untuk mendaftar.');
        return;
      }

      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Menyiapkan Midtrans Gateway...</span>';
      }

      // Generate Registration ID
      const randomNum = Math.floor(1000 + Math.random() * 9000);
      const regId = `BFW26-${randomNum}`;

      let basePrice = 80000;
      let baseDonasi = 20000;
      let paketTitle = 'Regular Pack 5K Early Bird';

      if (selectedPaket === 'donasi') {
        basePrice = 50000;
        baseDonasi = 50000;
        paketTitle = 'Donasi Only 5K';
      } else if (selectedPaket === 'family') {
        basePrice = 180000;
        baseDonasi = 20000;
        paketTitle = 'Family Pack 5K (2 Orang)';
      }

      const total = basePrice + additionalDonasi;
      const donasiTotal = baseDonasi + additionalDonasi;
      const regFee = total - donasiTotal;

      const namaVal = (document.getElementById('nama') as HTMLInputElement | null)?.value?.trim() || '-';
      const nama2Val = (document.getElementById('namaPeserta2') as HTMLInputElement | null)?.value?.trim();
      const emailVal = (document.getElementById('email') as HTMLInputElement | null)?.value?.trim() || '-';
      const waVal = (document.getElementById('whatsapp') as HTMLInputElement | null)?.value?.trim() || '-';
      const kontakDaruratNama = (document.getElementById('kontakDaruratNama') as HTMLInputElement | null)?.value?.trim() || '-';
      const kontakDaruratHp = (document.getElementById('kontakDaruratHp') as HTMLInputElement | null)?.value?.trim() || '-';

      const participantData: any = {
        id: regId,
        nama: namaVal,
        namaPeserta2: selectedPaket === 'family' ? (nama2Val || 'Peserta Ke-2') : '-',
        email: emailVal,
        whatsapp: waVal,
        gender: '-',
        nik: '-',
        alamat: '-',
        golDarah: '-',
        kontakDaruratNama: kontakDaruratNama,
        kontakDaruratHp: kontakDaruratHp,
        paket: selectedPaket,
        paketNama: paketTitle,
        ukuranJersey: selectedPaket === 'donasi' ? '-' : selectedSize,
        ukuranJersey2: selectedPaket === 'family' ? selectedSize2 : '-',
        nominalRegistrasi: regFee,
        nominalDonasi: donasiTotal,
        additionalDonasi: additionalDonasi,
        totalBayar: total,
        metodeBayar: selectedPayment,
        status: 'PENDING',
        waktuDaftar: new Date().toISOString(),
        waktuBayar: null,
        racepackClaimed: false,
        claimedAt: null,
        claimedBy: null
      };

      try {
        // Panggil endpoint backend untuk mendapatkan Snap Token
        const response = await fetch('/api/midtrans/token', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            ...participantData,
            preferredPayment: selectedPayment.includes('Muamalat') ? 'muamalat_va' : 'all'
          })
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || 'Gagal menghubungi server pembayaran Midtrans.');
        }

        // Cek apakah snap SDK terpasang di window dan bukan mock mode
        const snapGlobal = (window as any).snap;
        if (snapGlobal && typeof snapGlobal.pay === 'function' && !result.isMock) {
          snapGlobal.pay(result.token, {
            onSuccess: function(payResult: any) {
              participantData.status = 'PAID';
              participantData.waktuBayar = new Date().toISOString();
              participantData.metodeBayar = payResult.payment_type 
                ? `Midtrans (${payResult.payment_type.toUpperCase()})` 
                : selectedPayment;
              saveParticipant(participantData);
              showTicketModal(participantData);
            },
            onPending: function(payResult: any) {
              participantData.status = 'PENDING';
              participantData.metodeBayar = payResult.payment_type 
                ? `Midtrans (${payResult.payment_type.toUpperCase()})` 
                : selectedPayment;
              saveParticipant(participantData);
              showTicketModal(participantData);
              alert('Pesanan tercatat! Silakan selesaikan pembayaran sesuai instruksi VA/QRIS Anda.');
            },
            onError: function(err: any) {
              console.error('Midtrans payment error:', err);
              alert('Pembayaran gagal atau dibatalkan. Silakan ulangi kembali.');
              resetSubmitBtn();
            },
            onClose: function() {
              participantData.status = 'PENDING';
              saveParticipant(participantData);
              alert('Jendela pembayaran ditutup. Data pendaftaran Anda tersimpan sebagai PENDING.');
              resetSubmitBtn();
            }
          });
        } else {
          // Mode Simulasi / Pengujian Alur Lokal
          const proceedSimulation = confirm(
            `[SIMULASI MIDTRANS PAYMENT GATEWAY]\n\n` +
            `Token Snap: ${result.token}\n` +
            `ID Registrasi: ${regId}\n` +
            `Nama: ${participantData.nama}\n` +
            `Paket: ${participantData.paketNama}\n` +
            `Total Tagihan: Rp ${total.toLocaleString('id-ID')}\n` +
            `Metode: ${selectedPayment}\n\n` +
            `Klik [OK] untuk mensimulasikan PEMBAYARAN BERHASIL (LUNAS),\n` +
            `atau klik [Cancel] untuk mensimulasikan MENUNGGU PEMBAYARAN (PENDING).`
          );

          if (proceedSimulation) {
            participantData.status = 'PAID';
            participantData.waktuBayar = new Date().toISOString();
            participantData.metodeBayar = `${selectedPayment} (Midtrans Simulasi)`;
            saveParticipant(participantData);
            showTicketModal(participantData);
          } else {
            participantData.status = 'PENDING';
            participantData.metodeBayar = `${selectedPayment} (Midtrans Pending)`;
            saveParticipant(participantData);
            showTicketModal(participantData);
          }
          resetSubmitBtn();
        }
      } catch (err: any) {
        console.error('Error saat inisiasi Midtrans:', err);
        alert(`Terjadi kendala: ${err?.message || 'Gagal memproses pembayaran'}`);
        resetSubmitBtn();
      }
    });
  }
</script>
