---
import Layout from '../layouts/Layout.astro';
import { JERSEY_SIZES } from '../lib/utils.js';

declare const process: any;
const clientKey = (typeof process !== 'undefined' && process.env?.PUBLIC_MIDTRANS_CLIENT_KEY) || (import.meta as any).env?.PUBLIC_MIDTRANS_CLIENT_KEY || 'SB-Mid-client-sandbox-demo-key';
const isProduction = (typeof process !== 'undefined' && process.env?.MIDTRANS_IS_PRODUCTION === 'true') || (import.meta as any).env?.MIDTRANS_IS_PRODUCTION === 'true';
const snapJsUrl = isProduction 
  ? 'https://app.midtrans.com/snap/snap.js' 
  : 'https://app.sandbox.midtrans.com/snap/snap.js';
---

<Layout title="Pendaftaran Peserta — BAZNAS Fun Walk 2026" activePage="daftar">
  <!-- Midtrans Snap JS SDK -->
  <script is:inline src={snapJsUrl} data-client-key={clientKey}></script>

  <section class="sec sec--tint" style="padding-top:40px">
    <div class="wrap" style="max-width:880px">
      <!-- Header -->
      <div class="form-header-box">

        <p class="kicker">Registrasi Resmi</p>
        <h1>Formulir Pendaftaran BAZNAS Fun Walk 2026</h1>
        <p class="lede">
          Isi data diri dengan benar untuk penerbitan e-ticket, nomor BIB, dan alokasi ukuran jersey resmi Anda.
        </p>
      </div>

      <!-- Step Indicator -->
      <div class="steps-nav">
        <div class="step-indicator active" id="stepPill1">
          <span class="num">1</span>
          <span class="txt">Pilih Paket</span>
        </div>
        <div class="step-sep"></div>
        <div class="step-indicator" id="stepPill2">
          <span class="num">2</span>
          <span class="txt">Data Diri</span>
        </div>
        <div class="step-sep"></div>
        <div class="step-indicator" id="stepPill3">
          <span class="num">3</span>
          <span class="txt">Ukuran Jersey</span>
        </div>
        <div class="step-sep"></div>
        <div class="step-indicator" id="stepPill4">
          <span class="num">4</span>
          <span class="txt">Pembayaran</span>
        </div>
      </div>

      <!-- Form Container -->
      <div class="card-clean form-card">
        <form id="regForm">
          <!-- STEP 1: Pilih Paket -->
          <!-- STEP 1: Pilih Paket & Donasi Tambahan -->
          <div class="form-step-content" id="step1">
            <h3 class="step-title">Pilih Kategori Paket Kepesertaan</h3>
            <p class="hint" style="margin-bottom:24px">Silakan pilih kategori yang Anda inginkan. Fasilitas jalur 5K dan doorprize sama lengkapnya.</p>

            <div class="package-selector-grid">
              <!-- Paket Reguler -->
              <label class="package-option-card active" id="optReguler">
                <input type="radio" name="paket" value="reguler" checked class="sr-only">
                <div class="opt-header">
                  <div>
                    <div class="opt-name">Paket Reguler 5K</div>
                    <div class="opt-desc">1 Orang Peserta</div>
                  </div>
                  <span class="pill pill--sun">Early Bird</span>
                </div>
                <div class="opt-price">
                  <del style="font-size:0.9rem; opacity:0.6; text-decoration:line-through; margin-right:4px;">Rp 120.000</del>
                  <b>Rp 80.000</b>
                  <small style="color:var(--leaf); font-weight:700">Early Bird (Termasuk Donasi Rp 20.000)</small>
                </div>
                <ul class="opt-perks">
                  <li>✓ Jersey Drifit, Tote Bag & Wristband</li>
                  <li>✓ Nomor BIB & Kupon Doorprize Umroh</li>
                  <li>✓ <b>Termasuk Donasi ZIS Rp 20.000</b></li>
                </ul>
              </label>

              <!-- Family Pack -->
              <label class="package-option-card package-option-card--family" id="optFamily">
                <input type="radio" name="paket" value="family" class="sr-only">
                <div class="opt-header">
                  <div>
                    <div class="opt-name">Family Pack (2 Orang)</div>
                    <div class="opt-desc">Untuk 2 Peserta Sekaligus</div>
                  </div>
                  <span class="pill pill--lime" style="background:var(--leaf); color:#fff">Hemat Berdua</span>
                </div>
                <div class="opt-price">
                  <del style="font-size:0.9rem; opacity:0.6; text-decoration:line-through; margin-right:4px;">Rp 200.000</del>
                  <b>Rp 180.000</b>
                  <small style="color:var(--leaf); font-weight:700">Early Bird (Termasuk Donasi Rp 20.000)</small>
                </div>
                <ul class="opt-perks">
                  <li>✓ 2x Jersey Resmi</li>
                  <li>✓ 2x Kupon Doorprize Umroh</li>
                  <li>✓ 2x Tote Bag & Wristband</li>
                  <li>✓ <b>Termasuk Donasi ZIS Rp 20.000</b></li>
                </ul>
              </label>
            </div>

            <div class="step-btn-row" style="margin-top:32px; justify-content:flex-end">
              <button type="button" class="btn btn-leaf btn-lg" onclick="nextStep(2)">Lanjut ke Data Diri →</button>
            </div>
          </div>

          <!-- STEP 2: Data Diri Super Ringkas -->
          <div class="form-step-content" id="step2" style="display:none">
            <h3 class="step-title">Informasi Data Diri Peserta</h3>
            <p class="hint" style="margin-bottom:24px">Isi data diri dengan benar untuk penerbitan e-ticket dan kuitansi pembayaran resmi.</p>

            <div class="form-group" style="margin-bottom:18px">
              <label for="nama">Nama Lengkap Peserta (Utama) <span class="req">*</span></label>
              <input type="text" id="nama" name="nama" placeholder="Contoh: Ahmad Fauzi Ridwan" required>
              <span class="hint">Nama akan tercetak pada nomor BIB dan e-ticket.</span>
            </div>

            <div id="familyMemberRow" style="display:none; margin-bottom:18px">
              <div class="form-group">
                <label for="namaPeserta2">Nama Lengkap Peserta Ke-2 (Family Pack) <span style="font-weight:normal; color:var(--grey)">(Opsional)</span></label>
                <input type="text" id="namaPeserta2" name="namaPeserta2" placeholder="Contoh: Siti Maryam">
                <span class="hint">Nama anggota keluarga atau rekan yang ikut serta.</span>
              </div>
            </div>

            <div class="grid-2">
              <div class="form-group">
                <label for="whatsapp">Nomor WhatsApp Aktif <span class="req">*</span></label>
                <input type="tel" id="whatsapp" name="whatsapp" placeholder="08xxxxxxxxxx" required>
                <span class="hint">E-ticket & barcode verifikasi dikirimkan ke nomor ini.</span>
              </div>

              <div class="form-group">
                <label for="email">Alamat Email <span class="req">*</span></label>
                <input type="email" id="email" name="email" placeholder="nama@email.com" required>
                <span class="hint">Kuitansi resmi Midtrans otomatis dikirim ke email ini.</span>
              </div>
            </div>

            <!-- Kontak Darurat (Opsional) -->
            <div class="emergency-contact-box" style="margin-top:24px; padding:18px; background:var(--paper-2); border-radius:var(--r-md); border:1px solid var(--line);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px">
                <b style="color:var(--ink); font-size:0.95rem;">Kontak Darurat <span style="font-weight:normal; color:var(--grey)">(Opsional)</span></b>
                <span class="hint" style="margin:0">Untuk keamanan & koordinasi panitia</span>
              </div>
              <div class="grid-2">
                <div class="form-group">
                  <label for="kontakDaruratNama">Nama Kontak Darurat <span style="font-weight:normal; color:var(--grey)">(Opsional)</span></label>
                  <input type="text" id="kontakDaruratNama" name="kontakDaruratNama" placeholder="Nama keluarga / kerabat">
                </div>
                <div class="form-group">
                  <label for="kontakDaruratHp">Nomor HP / WhatsApp Darurat <span style="font-weight:normal; color:var(--grey)">(Opsional)</span></label>
                  <input type="tel" id="kontakDaruratHp" name="kontakDaruratHp" placeholder="08xxxxxxxxxx">
                </div>
              </div>
            </div>

            <div class="step-btn-row" style="margin-top:28px">
              <button type="button" class="btn btn-ghost-dark" onclick="prevStep(1)">← Kembali</button>
              <button type="button" class="btn btn-leaf btn-lg" onclick="validateStep2()">Lanjut ke Ukuran Jersey →</button>
            </div>
          </div>

          <!-- STEP 3: Ukuran Jersey -->
          <div class="form-step-content" id="step3" style="display:none">
            <div id="donasiOnlyJerseyNotice" style="display:none; text-align:center; padding:32px 16px;">
              <h3>Paket Donasi Only Tidak Memerlukan Jersey</h3>
              <p class="hint" style="max-width:520px; margin:8px auto 24px; font-size:0.95rem; line-height:1.5;">
                Paket Donasi Only merupakan donasi ZIS murni tanpa partisipasi jalan sehat di lapangan. Anda tidak perlu memilih ukuran jersey dan dapat langsung menuju ringkasan pembayaran.
              </p>
              <button type="button" class="btn btn-leaf btn-lg" onclick="nextStep(4)">Lanjut ke Pembayaran →</button>
            </div>

            <div id="regularJerseySection">
              <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:12px;">
                <h3 class="step-title" style="margin:0;">Pilih Ukuran Jersey Resmi</h3>
                <button type="button" class="btn btn-ghost-dark btn-sm" id="btnOpenSizeChart" style="display:inline-flex; align-items:center; gap:6px; font-weight:600; border-color:var(--moss); color:var(--moss);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/><path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/></svg>
                  <span>Panduan Ukuran (Size Chart)</span>
                </button>
              </div>
              <p class="hint" style="margin-bottom:20px">Jersey Microfiber Drifit unisex standar lari (Peserta Utama: Khusus Ukuran Dewasa).</p>

              <!-- Ukuran Dewasa (Peserta Utama) -->
              <div style="margin-bottom:20px">
                <div class="jersey-picker-grid">
                  {JERSEY_SIZES.filter(j => j.category === 'Dewasa').map(item => (
                    <label class="jersey-choice-card" id={`cardSize_${item.size}`}>
                      <input type="radio" name="ukuranJersey" value={item.size} class="sr-only">
                      <div class="size-circle">{item.size}</div>
                      <div class="size-specs">
                        <b>{item.desc}</b>
                      </div>
                      <div class="stock-status-pill">Tersedia</div>
                    </label>
                  ))}
                </div>
              </div>

              <!-- Extra Jersey Picker for Family Pack (Peserta 2) -->
              <div id="familySecondJerseyBox" style="display:none; margin-top:28px; padding-top:24px; border-top:2px dashed var(--line);">
                <h3 class="step-title">Pilih Ukuran Jersey Peserta Ke-2 (Family Pack)</h3>
                <p class="hint" style="margin-bottom:16px">Pilih ukuran jersey untuk anggota keluarga / rekan Anda (Tersedia Dewasa atau Anak):</p>
                
                <!-- Opsi Dewasa Peserta Ke-2 -->
                <h4 style="font-size:0.95rem; color:var(--moss); margin:0 0 10px;">Ukuran Dewasa</h4>
                <div class="jersey-picker-grid" style="margin-bottom:20px">
                  {JERSEY_SIZES.filter(j => j.category === 'Dewasa').map(item => (
                    <label class="jersey-choice-card jersey-choice-card--sec" id={`cardSecSize_${item.size}`}>
                      <input type="radio" name="ukuranJerseySec" value={item.size} class="sr-only">
                      <div class="size-circle">{item.size}</div>
                      <div class="size-specs">
                        <b>{item.desc}</b>
                      </div>
                      <div class="stock-status-pill">Tersedia</div>
                    </label>
                  ))}
                </div>

                <!-- Opsi Anak Peserta Ke-2 (Khusus Family Pack) -->
                <h4 style="font-size:0.95rem; color:var(--moss); margin:0 0 10px; display:flex; align-items:center; gap:6px;">
                  <span>Ukuran Anak</span>
                  <small style="color:var(--grey); font-weight:normal">(Usia 4 – 12 Tahun)</small>
                </h4>
                <div class="jersey-picker-grid">
                  {JERSEY_SIZES.filter(j => j.category === 'Anak').map(item => (
                    <label class="jersey-choice-card jersey-choice-card--sec" id={`cardSecSize_${item.size.replace(/\s+/g, '_')}`}>
                      <input type="radio" name="ukuranJerseySec" value={item.size} class="sr-only">
                      <div class="size-circle" style="background:#EBF5FF; color:#1E40AF">{item.size}</div>
                      <div class="size-specs">
                        <b>{item.desc}</b>
                      </div>
                      <div class="stock-status-pill">Tersedia</div>
                    </label>
                  ))}
                </div>
              </div>

              <div class="size-tip-banner" style="margin-top:20px">
                <b>Tips Ukuran:</b> Bahan Drifit elastis & adem. Jika ingin lebih leluasa atau berhijab, disarankan memilih 1 tingkat lebih besar.
              </div>

              <div class="step-btn-row" style="margin-top:32px">
                <button type="button" class="btn btn-ghost-dark" onclick="prevStep(2)">← Kembali</button>
                <button type="button" class="btn btn-leaf btn-lg" onclick="validateStep3()">Lanjut ke Pembayaran →</button>
              </div>
            </div>
          </div>

          <!-- STEP 4: Konfirmasi & Pembayaran -->
          <div class="form-step-content" id="step4" style="display:none">
            <h3 class="step-title">Konfirmasi & Metode Pembayaran</h3>
            <p class="hint" style="margin-bottom:20px">Periksa kembali ringkasan pendaftaran Anda sebelum menyelesaikan pesanan.</p>

            <div class="order-summary-box">
              <div class="summary-header">Ringkasan Pesanan</div>
              <div class="summary-row">
                <span>Nama Peserta:</span>
                <b id="summaryNama">-</b>
              </div>
              <div class="summary-row" id="summaryPeserta2Row" style="display:none">
                <span>Peserta Ke-2:</span>
                <b id="summaryNama2">-</b>
              </div>
              <div class="summary-row">
                <span>Kategori Paket:</span>
                <b id="summaryPaket">-</b>
              </div>
              <div class="summary-row">
                <span>Ukuran Jersey:</span>
                <b id="summarySize">-</b>
              </div>
              <div class="summary-row">
                <span>WhatsApp / Email:</span>
                <b id="summaryKontak">-</b>
              </div>
              <div class="summary-divider"></div>
              <div class="summary-row">
                <span>Biaya Paket:</span>
                <b id="summaryBiayaEvent">Rp 80.000</b>
              </div>
              <div class="summary-row" id="summaryDonasiRow">
                <span>Termasuk Donasi ZIS:</span>
                <b id="summaryDonasiVal" style="color:var(--leaf)">Rp 20.000</b>
              </div>
              <div class="summary-row" id="summaryExtraDonasiRow" style="display:none">
                <span>Infaq Sukarela Tambahan:</span>
                <b id="summaryExtraDonasiVal" style="color:var(--leaf)">+ Rp 0</b>
              </div>
              <div class="summary-total">
                <span>Total Pembayaran:</span>
                <span class="total-amount" id="summaryTotal">Rp 80.000</span>
              </div>
            </div>

            <!-- Additional Donation Box (Dibawah Total Pembayaran) -->
            <div class="additional-donation-box" style="margin-top:20px; background:var(--paper-2); padding:18px 20px; border-radius:var(--r-md); border:1px solid var(--line);">
              <div class="add-don-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px">
                <div class="add-don-title" style="font-weight:700; color:var(--ink); font-size:0.95rem">
                  <span>Tambah Infaq / Donasi Sukarela (Opsional)</span>
                </div>
                <span class="pill pill--sun" style="font-size:0.75rem; padding:2px 10px">Sedekah Berkah</span>
              </div>
              <p class="hint" style="margin-bottom:12px; font-size:0.85rem">
                Berapapun donasi tambahan Anda, seluruhnya disalurkan untuk beasiswa dhuafa & lansia prasejahtera di Kabupaten Bandung.
              </p>
              <div class="donation-chips-grid">
                <button type="button" class="don-chip active" data-val="0">Rp 0</button>
                <button type="button" class="don-chip" data-val="10000">+ Rp 10.000</button>
                <button type="button" class="don-chip" data-val="20000">+ Rp 20.000</button>
                <button type="button" class="don-chip" data-val="50000">+ Rp 50.000</button>
                <button type="button" class="don-chip" data-val="100000">+ Rp 100.000</button>
                <button type="button" class="don-chip" id="btnCustomDonasi" data-val="custom">Nominal Lainnya (Infaq Sukarela)</button>
              </div>
              <div id="customDonasiWrap" style="display:none; margin-top:14px">
                <label for="customDonasiInput" style="display:block; font-size:0.85rem; color:var(--moss); font-weight:600; margin-bottom:6px">
                  Silakan tentukan nominal infaq / donasi sukarela secara manual:
                </label>
                <div class="custom-don-input-box">
                  <span class="curr-prefix">Rp</span>
                  <input type="number" id="customDonasiInput" placeholder="Masukkan nominal infaq (contoh: 25000)" min="1000" step="5000" />
                </div>
              </div>
            </div>

            <h4 style="margin:28px 0 12px; color:var(--ink)">Pilih Metode Pembayaran</h4>
            <div class="payment-methods-grid">
              <label class="pay-method-card active">
                <input type="radio" name="metodeBayar" value="QRIS Instan" checked class="sr-only">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                  <div class="pay-title">QRIS Instan</div>
                  <span class="pill pill--dark" style="background:var(--leaf);color:#fff;font-size:0.75rem;padding:2px 8px">Rekomendasi</span>
                </div>
                <div class="pay-desc">Semua bank & e-wallet: Muamalat DIN, BCA, Mandiri, BRI, GoPay, ShopeePay, OVO, DANA</div>
              </label>

              <label class="pay-method-card">
                <input type="radio" name="metodeBayar" value="Bank Muamalat Virtual Account" class="sr-only">
                <div class="pay-title">Bank Muamalat Virtual Account</div>
                <div class="pay-desc">Bank Muamalat & Jaringan ATM Bersama / Prima dengan nomor VA unik instan</div>
              </label>
            </div>

            <!-- Agreement -->
            <div class="agreement-box" style="margin-top:24px">
              <label class="check-container">
                <input type="checkbox" id="agreeWaiver" required>
                <span>
                  Saya menyatakan data di atas benar, berada dalam kondisi sehat untuk jalan 5K, dan menyetujui <a href="/faq#sk" target="_blank">Syarat & Ketentuan</a> serta <a href="/faq#waiver" target="_blank">Waiver Kesehatan</a> BAZNAS Fun Walk 2026.
                </span>
              </label>
            </div>

            <div class="step-btn-row" style="margin-top:28px">
              <button type="button" class="btn btn-ghost-dark" onclick="prevStep(3)">← Kembali</button>
              <button type="submit" class="btn btn-sun btn-lg" id="submitBtn">
                <span>Konfirmasi & Bayar Sekarang </span>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Modal Sukses Pendaftaran / E-Ticket Popup -->
  <div class="modal-backdrop" id="successModal" style="display:none">
    <div class="modal-card">
      <div class="modal-icon"></div>
      <h2>Pendaftaran Berhasil!</h2>
      <p class="lede" style="font-size:1rem; margin-bottom:20px">
        Pesanan Anda telah tercatat pada sistem BAZNAS Fun Walk 2026. Nomor registrasi dan tiket digital resmi Anda telah terbit.
      </p>

      <div class="ticket-preview-box">
        <div class="tp-header">
          <div>
            <div class="tp-title">E-TICKET RESMI BAZNAS FUN WALK 2026</div>
            <div class="tp-sub">Sabtu, 21 November 2026 · Gedung Baznas Centre Soreang</div>
          </div>
          <span class="badge badge--success" id="modalBadge">LUNAS / VERIFIED</span>
        </div>

        <div class="tp-body">
          <div class="tp-qr-box">
            <!-- Simulated QR Code SVG -->
            <svg width="120" height="120" viewBox="0 0 100 100" fill="currentColor">
              <rect x="5" y="5" width="30" height="30" fill="none" stroke="currentColor" stroke-width="6"/>
              <rect x="13" y="13" width="14" height="14" fill="currentColor"/>
              <rect x="65" y="5" width="30" height="30" fill="none" stroke="currentColor" stroke-width="6"/>
              <rect x="73" y="13" width="14" height="14" fill="currentColor"/>
              <rect x="5" y="65" width="30" height="30" fill="none" stroke="currentColor" stroke-width="6"/>
              <rect x="13" y="73" width="14" height="14" fill="currentColor"/>
              <rect x="42" y="10" width="8" height="20" fill="currentColor"/>
              <rect x="42" y="42" width="16" height="16" fill="currentColor"/>
              <rect x="65" y="42" width="20" height="8" fill="currentColor"/>
              <rect x="70" y="65" width="20" height="20" fill="currentColor"/>
              <rect x="42" y="70" width="12" height="15" fill="currentColor"/>
            </svg>
            <div class="tp-id" id="modalRegId">BFW26-0000</div>
          </div>

          <div class="tp-details">
            <div>
              <small>Nama Peserta:</small>
              <b id="modalNama">-</b>
            </div>
            <div>
              <small>Kategori Paket:</small>
              <b id="modalPaket">-</b>
            </div>
            <div>
              <small>Ukuran Jersey:</small>
              <b id="modalSize">-</b>
            </div>
            <div>
              <small>Metode Pembayaran:</small>
              <b id="modalMetode">-</b>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-actions" style="margin-top:24px">
        <button type="button" class="btn btn-leaf btn-lg" onclick="downloadTicketImageFromModal()" style="display:inline-flex; align-items:center; justify-content:center; gap:8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>Unduh E-Ticket (PNG)</span>
        </button>
        <a href="/cek-tiket" class="btn btn-ghost-dark" id="modalViewTicketBtn">Buka di Halaman Cek Tiket</a>
      </div>
    </div>
  </div>

  <!-- Modal Panduan Ukuran (Size Chart) -->
  <div class="modal-backdrop" id="sizeChartModal" style="display:none">
    <div class="modal-card" style="max-width:620px; text-align:left;">
      <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--line); padding-bottom:14px; margin-bottom:18px;">
        <h3 style="margin:0; color:var(--ink); font-size:1.2rem; display:flex; align-items:center; gap:8px;">
