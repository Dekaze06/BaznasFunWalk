<script>
  // Dynamic countdown script for Early Bird opening (1 Oktober 2026 00:00:00 WIB)
  function updateCountdown() {
    // Target: Pembukaan Early Bird 1 Oktober 2026 00:00:00 WIB (UTC+7)
    const target = new Date('2026-10-01T00:00:00+07:00').getTime();
    const now = new Date().getTime();
    const diff = target - now;

    const lbl = document.getElementById('countdownLabel');

    if (diff <= 0) {
      if (lbl) lbl.textContent = 'Status Pendaftaran:';
      const container = document.getElementById('heroCountdown');
      if (container) container.innerHTML = '<div style="grid-column:1/-1;text-align:center;font-weight:700;color:var(--leaf);padding:10px;font-size:1.05rem">🎉 Pendaftaran Early Bird Telah Dibuka!</div>';
      const miniTimer = document.getElementById('earlyBirdMiniTimer');
      if (miniTimer) miniTimer.style.display = 'none';
      return;
    }

    if (lbl) lbl.textContent = 'Pendaftaran Early Bird Dibuka Dalam:';

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const secs = Math.floor((diff % (1000 * 60)) / 1000);

    const dEl = document.getElementById('cdDays');
    const hEl = document.getElementById('cdHours');
    const mEl = document.getElementById('cdMins');
    const sEl = document.getElementById('cdSecs');

    if (dEl) dEl.textContent = days.toString();
    if (hEl) hEl.textContent = hours.toString().padStart(2, '0');
    if (mEl) mEl.textContent = mins.toString().padStart(2, '0');
    if (sEl) sEl.textContent = secs.toString().padStart(2, '0');

    // Mini countdown inside price card
    const ebmD = document.getElementById('ebmDays');
    const ebmH = document.getElementById('ebmHours');
    const ebmM = document.getElementById('ebmMins');
    const ebmS = document.getElementById('ebmSecs');

    if (ebmD) ebmD.textContent = days.toString();
    if (ebmH) ebmH.textContent = hours.toString().padStart(2, '0');
    if (ebmM) ebmM.textContent = mins.toString().padStart(2, '0');
    if (ebmS) ebmS.textContent = secs.toString().padStart(2, '0');
  }

  setInterval(updateCountdown, 1000);
  updateCountdown();

  // Aceternity Timeline Scroll-driven Beam Animation
  function initTimelineScroll() {
    const container = document.getElementById('acTimelineContainer');
    const track = document.getElementById('acTimelineTrack');
    const beam = document.getElementById('acTimelineBeam');
    const items = document.querySelectorAll('.ac-timeline-item');

    if (!container || !track || !beam) return;

    function handleScroll() {
      const rect = container.getBoundingClientRect();
      const trackRect = track.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // Start calculating when container starts entering 20% from top
      // Complete when container end reaches 40% from bottom
      const startTrigger = windowHeight * 0.25;
      const endTrigger = windowHeight * 0.75;
      
      const totalScrollableDistance = rect.height;
      const currentProgress = (startTrigger - rect.top) / (totalScrollableDistance - 200);
      const clampedProgress = Math.max(0, Math.min(1, currentProgress));

      const trackHeight = track.offsetHeight;
      const targetBeamHeight = clampedProgress * trackHeight;

      beam.style.height = `${targetBeamHeight}px`;
      beam.style.opacity = clampedProgress > 0.01 ? '1' : '0';

      // Update active milestone
      items.forEach((item) => {
        const itemRect = item.getBoundingClientRect();
        // If item top has scrolled past 40% of the viewport or is currently in view
        if (itemRect.top <= windowHeight * 0.45 && itemRect.bottom >= windowHeight * 0.15) {
          item.classList.add('is-active');
        } else if (itemRect.top > windowHeight * 0.45) {
          item.classList.remove('is-active');
        }
      });
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', handleScroll);
    handleScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTimelineScroll);
  } else {
    initTimelineScroll();
  }
</script>
