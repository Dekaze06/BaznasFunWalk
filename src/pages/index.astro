---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getDashboardStats, readSettingsFromFile } from '../lib/server-db.js';
import { formatRupiah } from '../lib/utils.js';

const stats = getDashboardStats();
const settings = readSettingsFromFile();
const targetDonasi = Number(settings.targetDonasi) || 50000000;
const totalDonasi = Number(stats.totalDonasi) || 0;
const pctDonasi = Math.min(100, Math.round((totalDonasi / targetDonasi) * 1000) / 10);
const donaturCount = stats.paidCount || stats.totalPeserta || 0;
---

<Layout title="BAZNAS FUN WALK 2026 — Healthy and Charity | Soreang Kab. Bandung" activePage="home">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-image-box">
      <img 
        src="/assets/hero-model.webp" 
        alt="Peserta BAZNAS Fun Walk 2026 Mengenakan Jersey Resmi"
        class="hero-img"
        fetchpriority="high"
        width="2200"
        height="1555"
      />
    </div>

    <div class="wrap hero-wrap">
      <div class="hero-card">
        <div class="hero-grid">
          <div class="hero-info">
            <h1 class="hero-title">BAZNAS FUN WALK 2026</h1>
            <p class="hero-tagline">Healthy and Charity — Langkah Sehat, Berbagi Berkah</p>

            <ul class="hero-meta">
              <li>
                <span class="meta-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                </span>
                <div>
                  <span class="meta-lbl">Hari & Tanggal</span>
                  <b>Sabtu, 21 November 2026</b>
                </div>
              </li>
              <li>
                <span class="meta-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                </span>
                <div>
                  <span class="meta-lbl">Lokasi Start & Finish</span>
                  <b>Gedung Baznas Centre (Samping Yogya Soreang)</b>
                </div>
              </li>
              <li>
                <span class="meta-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </span>
                <div>
                  <span class="meta-lbl">Waktu Acara</span>
                  <b>Kumpul 05.30 WIB · Mulai 06.00 WIB</b>
                </div>
              </li>
            </ul>

            <div class="hero-cta-box">
              <a href="/daftar" class="btn btn-sun btn-lg">Daftar Sekarang</a>
              <a href="/paket" class="btn btn-ghost">Lihat Benefit Peserta</a>
            </div>
          </div>

          <div class="hero-pricing-card">
            <div class="pricing-badge">PROMO EARLY BIRD (1–14 OKTOBER)</div>
            <div class="pricing-label">Paket Reguler 5K</div>
            <div class="pricing-amount">
              <span class="curr">Rp</span>
              <span class="val">80.000</span>
            </div>
            <div class="pricing-was">Harga Normal: Rp 120.000 (Termasuk Donasi Rp 20.000)</div>

            <div class="countdown-wrapper">
              <div class="countdown-lbl">Sisa Waktu Pendaftaran Early Bird:</div>
              <div class="countdown-grid" id="heroCountdown">
                <div class="cd-box"><b id="cdDays">14</b><small>Hari</small></div>
                <div class="cd-box"><b id="cdHours">19</b><small>Jam</small></div>
                <div class="cd-box"><b id="cdMins">35</b><small>Menit</small></div>
                <div class="cd-box"><b id="cdSecs">20</b><small>Detik</small></div>
              </div>
            </div>

            <div class="charity-promo-tag">
              <b>Pilihan Paket Lengkap:</b> Donasi Only 50k, Regular Pack 80k (Early Bird), & Family Pack 180k (2 Orang). Semua paket memiliki opsi donasi tambahan suka rela!
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlight Numbers -->
  <section class="sec-stats">
    <div class="wrap stats-grid">
      <div class="stat-item">
        <div class="stat-num">5 KM</div>
        <div class="stat-desc">Rute Asri Kawasan Soreang</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">2.000+</div>
        <div class="stat-desc">Peserta Masyarakat & Komunitas</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">100%</div>
        <div class="stat-desc">Dana Donasi Disalurkan BAZNAS</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">UMROH</div>
        <div class="stat-desc">Hadiah Utama & Puluhan Hadiah Menarik</div>
      </div>
    </div>
  </section>

  <!-- Section Crowdfunding & Data Donasi Live -->
  <section class="sec sec-crowdfunding" id="crowdfunding">
    <div class="wrap">
      <div class="cf-container card-clean">
        <div class="cf-header-grid">
          <div>
            <h2 class="cf-title" style="margin-top:0">Crowdfunding Donasi BAZNAS Fun Walk 2026</h2>
            <p class="cf-desc">
              Melangkah sehat sembari menabur senyum. Setiap pendaftaran paket jalan sehat dan infak sukarela tambahan Anda dihimpun untuk mendukung program kemaslahatan umat dhuafa di Kabupaten Bandung.
            </p>
          </div>

          <div class="cf-card-summary">
            <div class="cf-raised-lbl">Total Dana Donasi Terhimpun</div>
            <div class="cf-raised-val" id="cfTotalDonasi">{formatRupiah(totalDonasi)}</div>
            <div class="cf-target-row">
              <span>Target Donasi: <b>Rp 50.000.000</b></span>
              <span id="cfPercent" class="cf-percent-pill">{pctDonasi}%</span>
            </div>
            <div class="cf-progress-track">
              <div class="cf-progress-fill" id="cfProgressFill" style={`width: ${pctDonasi}%`}></div>
            </div>
            <div class="cf-stats-mini">
              <div>
                <b id="cfDonaturCount">{donaturCount}</b>
                <small>Pendaftar & Donatur</small>
              </div>
              <div class="cf-mini-sep"></div>
              <div>
                <b>100%</b>
                <small>Amanah Lembaga</small>
              </div>
              <div class="cf-mini-sep"></div>
              <div>
                <b>Kab. Bandung</b>
                <small>Wilayah Penyaluran</small>
              </div>
            </div>
          </div>
        </div>

        <div class="cf-programs-grid">
          <div class="cf-prog-item">
            <div class="cf-prog-icon icon-edu">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            </div>
            <h4>Beasiswa Pendidikan Dhuafa</h4>
            <p>Bantuan SPP dan perlengkapan sekolah untuk santri dan pelajar prasejahtera di Kabupaten Bandung.</p>
          </div>
          <div class="cf-prog-item">
            <div class="cf-prog-icon icon-health">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            </div>
            <h4>Layanan Medis & Lansia Rentan</h4>
            <p>Bantuan pengobatan, obat-obatan berkala, dan paket gizi seimbang untuk kaum lansia dhuafa.</p>
          </div>
          <div class="cf-prog-item">
            <div class="cf-prog-icon icon-econ">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <h4>Pemberdayaan Ekonomi Mustahik</h4>
            <p>Modal bergulir UMKM binaan BAZNAS, gerobak berkah, dan pendampingan usaha keluarga mandiri.</p>
          </div>
        </div>

        <div class="cf-bottom-action">
          <span>Ingin ikut berdonasi sekaligus mengikuti jalan sehat 5K?</span>
          <a href="/daftar" class="btn btn-leaf btn-sm">Daftar Sekarang & Salurkan Donasi →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Aceternity-style Interactive Timeline Section -->
  <section class="sec timeline-section" id="timeline-flow">
    <div class="wrap">
      <div class="timeline-intro">
        <h2 class="timeline-main-title">Rangkaian Acara BAZNAS Fun Walk 2026</h2>
      </div>

      <!-- Container Timeline -->
      <div class="ac-timeline-container" id="acTimelineContainer">
        <!-- Vertical Animated Beam Track -->
        <div class="ac-timeline-track" id="acTimelineTrack">
          <div class="ac-timeline-beam" id="acTimelineBeam"></div>
        </div>

        <div class="ac-timeline-list" id="acTimelineList">
          
          <!-- STEP 1: Tentang Acara -->
          <div class="ac-timeline-item" data-step="1">
            <div class="ac-timeline-left">
              <div class="ac-bullet-wrapper">
                <div class="ac-bullet-outer">
                  <div class="ac-bullet-inner"></div>
                </div>
              </div>
              <div class="ac-sticky-title">
                <span class="ac-step-badge">Fase 01</span>
                <h3>Tentang Acara</h3>
              </div>
            </div>

            <div class="ac-timeline-right">
              <div class="ac-mobile-header">
                <span class="ac-step-badge">Fase 01</span>
                <h3>Tentang Acara</h3>
              </div>

              <div class="ac-card-panel">
                <p class="kicker">Konsep Healthy & Charity</p>
                <p>
                  Melalui semangat <b>Healthy & Charity</b>, setiap langkah kita menjadi donasi nyata bagi beasiswa pendidikan dhuafa, layanan kesehatan, dan pemberdayaan umat bersama BAZNAS Kab. Bandung.
                </p>

                <div class="benefit-points" style="margin-top:24px">
                  <div class="point-row">
                    <span class="point-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                    </span>
                    <div>
                      <b>Jersey Eksklusif & Perlengkapan Resmi</b>
                      <p>Bahan drifit premium berstandar lari, tote bag ramah lingkungan, dan wristband resmi ber-barcode.</p>
                    </div>
                  </div>
                  <div class="point-row">
                    <span class="point-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
                    </span>
                    <div>
                      <b>Kupon Doorprize Utama & Hadiah Menarik</b>
                      <p>Hadiah utama paket Umroh dan puluhan hadiah menarik lainnya, tausiyah kebersamaan, dan panggung santai.</p>
                    </div>
                  </div>
                  <div class="point-row">
                    <span class="point-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                    </span>
                    <div>
                      <b>Kebaikan Zakat, Infak & Sedekah</b>
                      <p>Setiap paket kepesertaan menyertakan donasi ZIS yang disalurkan amanah melalui BAZNAS Kab. Bandung.</p>
                    </div>
                  </div>
                </div>

                <div class="ac-media-grid" style="margin-top:28px">
                  <div class="img-frame">
                    <img 
                      src="/assets/racepack-benefit.webp" 
                      alt="Official Race Pack BAZNAS Fun Walk 2026" 
                      class="benefit-img"
                      loading="lazy"
                      width="2200"
                      height="1555"
                    />
                    <div class="img-caption">Official Race Pack: Jersey Drifit, Tote Bag & Official Wristband</div>
                  </div>
                </div>

                <div style="margin-top:28px; display:flex; gap:12px; flex-wrap:wrap">
                  <a href="/daftar" class="btn btn-leaf">Daftar Ikut Fun Walk</a>
                  <a href="/rute" class="btn btn-ghost-dark">Eksplor Rute 5K</a>
                </div>
              </div>
            </div>
          </div>

          <!-- STEP 2: Pilihan Registrasi -->
          <div class="ac-timeline-item" data-step="2">
            <div class="ac-timeline-left">
              <div class="ac-bullet-wrapper">
                <div class="ac-bullet-outer">
                  <div class="ac-bullet-inner"></div>
                </div>
              </div>
              <div class="ac-sticky-title">
                <span class="ac-step-badge">Fase 02</span>
                <h3>Pilihan Paket</h3>
              </div>
            </div>

            <div class="ac-timeline-right">
              <div class="ac-mobile-header">
                <span class="ac-step-badge">Fase 02</span>
                <h3>Pilihan Paket</h3>
              </div>

              <div class="ac-card-panel">
                <p class="kicker" style="margin-bottom:24px">Pilihan Registrasi</p>

                <div class="paket-cards-grid" id="homePaketCardsGrid">
                  <!-- Paket Donasi Only -->
                  <div class="card-clean paket-card" id="cardHome_donasi">
                    <div class="card-pill">Murni ZIS</div>
                    <h3>Donasi Only</h3>
                    <p class="card-sub">Berinfaq untuk kemaslahatan umat tanpa kepesertaan jalan sehat.</p>
                    
                    <div class="card-price">
                      <span class="price-val">Rp 50.000</span>
                      <span class="price-period">/ donasi</span>
                    </div>
                    <div class="price-normal-tag" style="color:var(--leaf); font-weight:700">100% Disalurkan untuk ZIS BAZNAS</div>

                    <ul class="benefit-checklist">
                      <li>Pahala sedekah untuk program mustahik</li>
                      <li style="color:var(--grey); opacity:0.7">✕ Tanpa kupon doorprize umroh</li>
                      <li style="color:var(--grey); opacity:0.7">✕ Tanpa jersey resmi</li>
                      <li style="color:var(--grey); opacity:0.7">✕ Tidak perlu ambil racepack</li>
                    </ul>

                    <a href="/daftar?paket=donasi&step=2" class="btn btn-ghost-dark" style="width:100%; text-align:center;">Pilih Donasi Only</a>
                  </div>

                  <!-- Paket Reguler -->
                  <div class="card-clean paket-card paket-card--featured active" id="cardHome_reguler">
                    <div class="card-pill card-pill--sun">Paling Populer</div>
                    <h3>Regular Pack 5K</h3>
                    <p class="card-sub">Jalan sehat 5K lengkap untuk 1 orang peserta.</p>
                    
                    <div class="card-price">
                      <del class="price-strikethrough" style="font-size:1.1rem; opacity:0.6; text-decoration:line-through; margin-right:6px">Rp 120.000</del>
                      <span class="price-val">Rp 80.000</span>
                      <span class="price-period">/ orang (Early Bird)</span>
                    </div>
                    <div class="price-normal-tag" style="color:var(--leaf); font-weight:700">Harga Spesial Early Bird (Termasuk Donasi Rp 20.000)</div>

                    <ul class="benefit-checklist">
                      <li>Jersey Resmi BAZNAS Fun Walk (Drifit)</li>
                      <li>Tote Bag Ramah Lingkungan Eksklusif</li>
                      <li>Gelang Resmi / Official Wristband</li>
                      <li>Nomor Peserta & Tiket Digital (QR Code)</li>
                      <li>Kupon Doorprize Hadiah Utama Umroh</li>
                      <li>Refreshment Air Mineral</li>
                      <li><b>Termasuk Donasi ZIS Rp 20.000</b></li>
                    </ul>

                    <a href="/daftar?paket=reguler&step=2" class="btn btn-sun" style="width:100%; text-align:center;">Pilih Regular Pack</a>
                  </div>

                  <!-- Family Pack -->
                  <div class="card-clean paket-card paket-card--charity" id="cardHome_family">
                    <div class="card-pill card-pill--lime">Hemat Berdua</div>
                    <h3>Family Pack (2 Orang)</h3>
                    <p class="card-sub">Paket hemat jalan sehat untuk 2 orang keluarga / kerabat.</p>
                    
                    <div class="card-price">
                      <span class="price-val">Rp 180.000</span>
                      <span class="price-period">/ paket (2 Orang)</span>
                    </div>
                    <div class="price-normal-tag" style="color:var(--leaf); font-weight:700">Termasuk Donasi Rp 20.000 untuk Sesama</div>

                    <ul class="benefit-checklist">
                      <li><b>2x Jersey Resmi</b></li>
                      <li><b>2x Kupon Doorprize Hadiah Utama Umroh</b></li>
                      <li>2x Official Eco Tote Bag & Wristband</li>
                      <li>2x Nomor Peserta & E-Ticket Digital</li>
                      <li>2x Refreshment Air Mineral</li>
                      <li><b>Termasuk Donasi ZIS Rp 20.000</b></li>
                    </ul>

                    <a href="/daftar?paket=family&step=2" class="btn btn-leaf" style="width:100%; text-align:center;">Pilih Family Pack</a>
                  </div>
                </div>

                <div style="text-align:center; margin-top:28px">
                  <a href="/paket" class="link-more">Pelajari Detail Benefit & Panduan Ukuran Jersey →</a>
                </div>
              </div>
            </div>
          </div>

          <!-- STEP 3: Rute 5K -->
          <div class="ac-timeline-item" data-step="3">
            <div class="ac-timeline-left">
              <div class="ac-bullet-wrapper">
                <div class="ac-bullet-outer">
                  <div class="ac-bullet-inner"></div>
                </div>
              </div>
              <div class="ac-sticky-title">
                <span class="ac-step-badge">Fase 03</span>
                <h3>Rute 5K</h3>
              </div>
            </div>

            <div class="ac-timeline-right">
              <div class="ac-mobile-header">
                <span class="ac-step-badge">Fase 03</span>
                <h3>Rute 5K</h3>
              </div>

              <div class="ac-card-panel ac-card-panel--dark">
                <p class="kicker kicker--light" style="margin-bottom:16px">Rute 5 Kilometer</p>
                <p class="lede" style="color:#d5e7d5; margin-bottom:24px">
                  Dirancang nyaman dan aman untuk segala usia, mulai dari anak-anak hingga orang tua. Rute melingkari kawasan utama Soreang dengan aspal mulus dan titik hidrasi terjamin.
                </p>

                <div class="ac-route-grid">
                  <div class="route-img-box">
                    <img 
                      src="/assets/route-map-detail.webp" 
                      alt="Peta Rute 5K BAZNAS Fun Walk Soreang" 
                      class="route-map-img"
                      loading="lazy"
                      width="880"
                      height="1125"
                    />
                  </div>

                  <div>
                    <ul class="route-highlights">
                      <li>
                        <span class="route-num">1</span>
                        <div><b>Start:</b> Gedung Baznas Centre (Samping Yogya Soreang)</div>
                      </li>
                      <li>
                        <span class="route-num">2</span>
                        <div><b>Water Station:</b> KM 2 (Depan Yadika) & KM 4 (Jalur Soreang Centre)</div>
                      </li>
                      <li>
                        <span class="route-num">3</span>
                        <div><b>Pos Medis & Ambulans:</b> Siaga di sepanjang jalur lintasan</div>
                      </li>
                      <li>
                        <span class="route-num">4</span>
                        <div><b>Finish:</b> Kembali ke Gedung Baznas Centre untuk panggung hiburan & doorprize</div>
                      </li>
                    </ul>

                    <div style="margin-top:28px">
                      <a href="/rute" class="btn btn-sun">Buka Panduan Rute & Titik Pos</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- STEP 4: Timeline & Agenda -->
          <div class="ac-timeline-item" data-step="4">
            <div class="ac-timeline-left">
              <div class="ac-bullet-wrapper">
                <div class="ac-bullet-outer">
                  <div class="ac-bullet-inner"></div>
                </div>
              </div>
              <div class="ac-sticky-title">
                <span class="ac-step-badge">Fase 04</span>
                <h3>Jadwal Acara</h3>
              </div>
            </div>

            <div class="ac-timeline-right">
              <div class="ac-mobile-header">
                <span class="ac-step-badge">Fase 04</span>
                <h3>Jadwal Acara</h3>
              </div>

              <div class="ac-card-panel">
                <p class="kicker" style="margin-bottom:16px">Jadwal Penting</p>
                <p class="lede" style="margin-bottom:28px">Catat tanggal-tanggal penting agar persiapan Anda dan keluarga maksimal.</p>

                <div class="timeline-row">
                  <div class="timeline-step">
                    <div class="step-date">1 – 14 Oktober</div>
                    <div class="step-title">Pendaftaran Early Bird</div>
                    <p class="step-desc">Tarif spesial Rp 80.000 untuk paket Reguler (termasuk donasi ZIS Rp 20.000).</p>
                  </div>
                  <div class="timeline-step">
                    <div class="step-date">15 Okt – 17 Nov</div>
                    <div class="step-title">Pendaftaran Normal</div>
                    <p class="step-desc">Tarif normal Rp 120.000 (Reguler) dan Rp 180.000 (Family Pack 2 Orang).</p>
                  </div>
                  <div class="timeline-step">
                    <div class="step-date">19 – 20 November</div>
                    <div class="step-title">Race Pack Collection (RPC)</div>
                    <p class="step-desc">Pengambilan jersey, tote bag & wristband di Gedung Baznas Centre (samping Yogya Soreang).</p>
                  </div>
                  <div class="timeline-step active">
                    <div class="step-date">Sabtu, 21 November</div>
                    <div class="step-title">Hari-H Pelaksanaan</div>
                    <p class="step-desc">Kumpul 05.30 WIB, Flag-off 06.00 WIB di Gedung Baznas Centre (samping Yogya Soreang).</p>
                  </div>
                </div>

