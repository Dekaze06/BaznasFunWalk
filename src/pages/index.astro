  .ac-route-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 32px;
    align-items: center;
  }

  .kicker--light {
    color: var(--lime) !important;
  }

  @media (max-width: 900px) {
    .ac-timeline-left {
      display: none;
