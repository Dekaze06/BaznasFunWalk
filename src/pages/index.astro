  .ac-bullet-inner {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #CBD5E1;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ac-timeline-item.is-active .ac-bullet-outer {
    border-color: #10B981;
    box-shadow: 0 0 0 6px rgba(16, 185, 129, 0.16), 0 4px 16px rgba(16, 185, 129, 0.25);
