---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getDashboardStats, readSettingsFromFile } from '../lib/server-db.js';
import { formatRupiah } from '../lib/utils.js';

const stats = getDashboardStats();
const settings = readSettingsFromFile();
const targetDonasi = Number(settings.targetDonasi) || 50000000;
const totalDonasi = Number(stats.totalDonasi) || 0;
const pctDonasi = Math.min(100, Math.round((totalDonasi / targetDonasi) * 1000) / 10);
const donaturCount = stats.paidCount || stats.totalPeserta || 0;
---

<Layout title="BAZNAS FUN WALK 2026 — Healthy and Charity | Soreang Kab. Bandung" activePage="home">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-image-box">
      <img 
        src="/assets/hero-model.webp" 
        alt="Peserta BAZNAS Fun Walk 2026 Mengenakan Jersey Resmi"
        class="hero-img"
        fetchpriority="high"
        width="2200"
        height="1555"
      />
    </div>

    <div class="wrap hero-wrap">
      <div class="hero-card">
        <div class="hero-grid">
          <div class="hero-info">
            <h1 class="hero-title">BAZNAS FUN WALK 2026</h1>
            <p class="hero-tagline">Healthy and Charity — Langkah Sehat, Berbagi Berkah</p>

            <ul class="hero-meta">
              <li>
                <span class="meta-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                </span>
                <div>
                  <span class="meta-lbl">Hari & Tanggal</span>
                  <b>Sabtu, 21 November 2026</b>
                </div>
              </li>
              <li>
                <span class="meta-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                </span>
                <div>
                  <span class="meta-lbl">Lokasi Start & Finish</span>
                  <b>DOME Bale Rame Soreang</b>
                </div>
              </li>
              <li>
                <span class="meta-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </span>
                <div>
                  <span class="meta-lbl">Waktu Acara</span>
                  <b>Kumpul 05.30 WIB · Mulai 06.00 WIB</b>
                </div>
              </li>
            </ul>

            <div class="hero-cta-box">
              <a href="/daftar" class="btn btn-sun btn-lg">Daftar Sekarang</a>
            </div>
          </div>

          <div class="hero-pricing-card">
            <div class="pricing-badge">PROMO EARLY BIRD (1–7 OKTOBER)</div>
            <div class="pricing-label">Paket Reguler 5K</div>
            <div class="pricing-amount">
              <span class="curr">Rp</span>
              <span class="val">100.000</span>
            </div>
            <div class="pricing-was">Harga Normal: Rp 120.000</div>

            <div class="countdown-wrapper">
              <div class="countdown-lbl" id="countdownLabel">Pendaftaran Early Bird Dibuka Dalam:</div>
              <div class="countdown-grid" id="heroCountdown">
                <div class="cd-box"><b id="cdDays">00</b><small>Hari</small></div>
                <div class="cd-box"><b id="cdHours">00</b><small>Jam</small></div>
                <div class="cd-box"><b id="cdMins">00</b><small>Menit</small></div>
                <div class="cd-box"><b id="cdSecs">00</b><small>Detik</small></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlight Numbers -->
  <section class="sec-stats">
    <div class="wrap stats-grid">
      <div class="stat-item">
        <div class="stat-num">4 KM</div>
        <div class="stat-desc">Rute Asri Kawasan Soreang</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">2.000+</div>
        <div class="stat-desc">Peserta Masyarakat & Komunitas</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">100%</div>
        <div class="stat-desc">Dana Infaq Disalurkan BAZNAS</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">UMROH</div>
        <div class="stat-desc">Hadiah Utama & Puluhan Hadiah Menarik</div>
      </div>
    </div>
  </section>

  <!-- Aceternity-style Interactive Timeline Section -->
  <section class="sec timeline-section" id="timeline-flow">
    <div class="wrap">
      <div class="timeline-intro">
        <span class="timeline-kicker">Rangkaian Acara BAZNAS Fun Walk 2026</span>
        <h2 class="timeline-main-title">Perjalanan Langkah Sehat & Berkah</h2>
        <p class="timeline-main-desc">
          Telusuri setiap fase kegiatan dari filosofi kebaikan, paket partisipasi, rute eksklusif 5K, hingga agenda puncak pelaksanaan 21 November 2026.
        </p>
      </div>

      <!-- Container Timeline -->
      <div class="ac-timeline-container" id="acTimelineContainer">
        <!-- Vertical Animated Beam Track -->
        <div class="ac-timeline-track" id="acTimelineTrack">
          <div class="ac-timeline-beam" id="acTimelineBeam"></div>
        </div>

        <div class="ac-timeline-list" id="acTimelineList">
          
          <!-- STEP 1: Tentang Acara -->
          <div class="ac-timeline-item" data-step="1">
            <div class="ac-timeline-left">
              <div class="ac-bullet-wrapper">
                <div class="ac-bullet-outer">
                  <div class="ac-bullet-inner"></div>
                </div>
              </div>
              <div class="ac-sticky-title">
                <span class="ac-step-badge">Fase 01</span>
                <h3>Tentang Acara</h3>
              </div>
            </div>

            <div class="ac-timeline-right">
              <div class="ac-mobile-header">
                <span class="ac-step-badge">Fase 01</span>
                <h3>Tentang Acara</h3>
              </div>

              <div class="ac-card-panel">
                <p class="kicker">Konsep Healthy & Charity</p>
                <h2 style="font-size:clamp(1.6rem, 3vw, 2.2rem); margin-bottom:12px">Langkah Ringan Penuh Berkah di Soreang</h2>
                <p class="lede">
                  Jalan sehat bersama <b>BAZNAS Kabupaten Bandung</b> yang memadukan olahraga rekreasi, silaturahmi akbar, dan aksi infaq kemanusiaan.
                </p>
                <p>
                  Mengusung konsep <b>Healthy & Charity</b>, setiap langkah di rute asri Soreang disalurkan langsung untuk beasiswa dhuafa dan pemberdayaan mustahik.
                </p>

                <div class="benefit-points" style="margin-top:24px">
                  <div class="point-row">
                    <span class="point-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                    </span>
                    <div>
                      <b>Perlengkapan Resmi & Jersey</b>
                      <p>Jersey resmi premium, gelang identitas peserta, goodie bag, dan kupon doorprize BAZNAS.</p>
                    </div>
                  </div>
                  <div class="point-row">
                    <span class="point-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
                    </span>
                    <div>
                      <b>Kupon Doorprize Utama & Hiburan</b>
                      <p>Hadiah utama Umroh, sepeda motor, sepeda listrik, aneka doorprize, dan tausiyah.</p>
                    </div>
                  </div>
                  <div class="point-row">
                    <span class="point-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                    </span>
                    <div>
                      <b>Kebaikan Infaq</b>
                      <p>Infaq tercatat resmi dan disalurkan amanah langsung oleh BAZNAS Kabupaten Bandung.</p>
                    </div>
                  </div>
                </div>

                <div class="ac-media-grid" style="margin-top:28px">
                  <div class="img-frame">
                    <img 
                      src="/assets/racepack-benefit.webp" 
                      alt="Official Race Pack BAZNAS Fun Walk 2026" 
                      class="benefit-img"
                      loading="lazy"
                      width="2200"
                      height="1555"
                    />
                    <div class="img-caption">Official Race Pack: Jersey Resmi, Gelang, dan Goodie Bag BAZNAS Fun Walk</div>
                  </div>
                </div>

                <div style="margin-top:28px; display:flex; gap:12px; flex-wrap:wrap">
                  <a href="/daftar" class="btn btn-leaf">Daftar Ikut Fun Walk</a>
                  <a href="/rute" class="btn btn-ghost-dark">Eksplor Rute 5K</a>
                </div>
              </div>
            </div>
          </div>

          <!-- STEP 2: Pilihan Registrasi -->
          <div class="ac-timeline-item" data-step="2">
            <div class="ac-timeline-left">
              <div class="ac-bullet-wrapper">
                <div class="ac-bullet-outer">
                  <div class="ac-bullet-inner"></div>
                </div>
              </div>
              <div class="ac-sticky-title">
                <span class="ac-step-badge">Fase 02</span>
                <h3>Pilihan Paket</h3>
              </div>
            </div>

            <div class="ac-timeline-right">
              <div class="ac-mobile-header">
                <span class="ac-step-badge">Fase 02</span>
                <h3>Pilihan Paket</h3>
              </div>

              <div class="ac-card-panel">
                <p class="kicker">Pilihan Registrasi</p>
                <h2 style="font-size:clamp(1.6rem, 3vw, 2.2rem); margin-bottom:10px">Daftar Sesuai Niat & Keinginan Anda</h2>
                <p class="lede" style="margin-bottom:28px">
                  Tersedia dua kategori kepesertaan dengan seluruh benefit lengkap dan fasilitas yang sama di hari acara.
                </p>

                <div class="paket-cards-grid">
                  <!-- Paket Reguler -->
                  <div class="card-clean paket-card paket-card--featured">
                    <div class="card-pill card-pill--sun">Early Bird 1–7 Oktober</div>
                    <h3>Paket Reguler 5K</h3>
                    <p class="card-sub">Pilihan jalan sehat untuk individu dan keluarga.</p>
                    
                    <div class="card-price">
                      <span class="price-val">Rp 100.000</span>
                      <span class="price-period">/ orang (Early Bird)</span>
                    </div>
                    <div class="price-normal-tag">Harga Normal: <del>Rp 120.000</del></div>
                    <div class="early-bird-badge-note">✨ Termasuk Infaq Rp 20.000</div>

                    <ul class="benefit-checklist">
                      <li>Jersey Resmi BAZNAS Fun Walk</li>
                      <li>Gelang Resmi</li>
                      <li>Goodie Bag</li>
                      <li>Kupon Undian Doorprize Utama Hadiah Umroh</li>
                      <li>Refreshment Air Mineral</li>
                    </ul>

                    <a href="/daftar?paket=reguler" class="btn btn-sun" style="width:100%">Pilih Paket Reguler</a>
                  </div>

                  <!-- Family Pack -->
                  <div class="card-clean paket-card paket-card--family">
                    <div class="card-pill card-pill--lime">Hemat Berdua</div>
                    <h3>Family Pack 5K</h3>
                    <p class="card-sub">Pilihan hemat jalan sehat untuk 2 orang (keluarga/rekan).</p>
                    
                    <div class="card-price">
                      <span class="price-val">Rp 200.000</span>
                      <span class="price-period">/ 2 orang</span>
                    </div>
                    <div class="price-normal-tag" style="color:var(--leaf); font-weight:700">(Untuk 2 Orang) Termasuk Infaq Rp 20.000</div>

                    <ul class="benefit-checklist">
                      <li><b>2x Jersey Resmi BAZNAS Fun Walk</b></li>
                      <li><b>2x Gelang Resmi</b></li>
                      <li><b>2x Goodie Bag</b></li>
                      <li><b>2x Kupon Undian Doorprize Umroh</b></li>
                      <li><b>Termasuk Infaq Rp 20.000 Resmi</b></li>
                      <li>2x Refreshment Air Mineral</li>
                    </ul>

                    <a href="/daftar?paket=family" class="btn btn-leaf" style="width:100%">Pilih Family Pack</a>
                  </div>
                </div>

                <div style="text-align:center; margin-top:28px">
                  <a href="/paket" class="link-more">Pelajari Detail Benefit & Panduan Ukuran Jersey →</a>
                </div>
              </div>
            </div>
          </div>

          <!-- STEP 3: Rute 5K -->
          <div class="ac-timeline-item" data-step="3">
            <div class="ac-timeline-left">
              <div class="ac-bullet-wrapper">
                <div class="ac-bullet-outer">
                  <div class="ac-bullet-inner"></div>
                </div>
              </div>
              <div class="ac-sticky-title">
                <span class="ac-step-badge">Fase 03</span>
                <h3>Rute 4K</h3>
              </div>
            </div>

            <div class="ac-timeline-right">
              <div class="ac-mobile-header">
                <span class="ac-step-badge">Fase 03</span>
                <h3>Rute 4K</h3>
              </div>

              <div class="ac-card-panel ac-card-panel--dark">
                <p class="kicker kicker--light">Rute 4 Kilometer</p>
                <h2 style="font-size:clamp(1.6rem, 3vw, 2.2rem); color:#ffffff; margin-bottom:12px">Satu Putaran Penuh Nuansa Soreang</h2>
                <p class="lede" style="color:#d5e7d5; margin-bottom:24px">
                  Dirancang nyaman dan aman untuk segala usia, mulai dari anak-anak hingga orang tua. Rute melingkari kawasan utama Soreang dengan aspal mulus dan titik hidrasi terjamin.
                </p>

                <div class="ac-route-grid">
                  <div class="route-img-box">
                    <img 
                      src="/assets/route-map-detail.webp" 
                      alt="Peta Rute 4K BAZNAS Fun Walk Soreang" 
                      class="route-map-img"
                      loading="lazy"
                      width="880"
                      height="1125"
                    />
                  </div>

                  <div>
                    <ul class="route-highlights">
                      <li>
                        <span class="route-num">1</span>
                        <div><b>Start:</b> DOME Bale Rame Soreang</div>
                      </li>
                      <li>
                        <span class="route-num">2</span>
                        <div><b>KM 1:</b> Jl. Raya Soreang (Sebelum Gapura)</div>
                      </li>
                      <li>
                        <span class="route-num">3</span>
                        <div><b>KM 2:</b> Jl. Raya Gading Tutuka / Jl. Baru (Sebelum Geo Dipa)</div>
                      </li>
                      <li>
                        <span class="route-num">4</span>
                        <div><b>KM 3:</b> Koridor Jl. Tol Soroja</div>
                      </li>
                      <li>
                        <span class="route-num">5</span>
                        <div><b>KM 4 & Finish:</b> DOME Bale Rame Soreang</div>
                      </li>
                    </ul>

                    <div style="margin-top:28px">
                      <a href="/rute" class="btn btn-sun">Buka Panduan Rute & Titik Pos</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- STEP 4: Timeline & Agenda -->
          <div class="ac-timeline-item" data-step="4">
            <div class="ac-timeline-left">
              <div class="ac-bullet-wrapper">
                <div class="ac-bullet-outer">
                  <div class="ac-bullet-inner"></div>
                </div>
              </div>
              <div class="ac-sticky-title">
                <span class="ac-step-badge">Fase 04</span>
                <h3>Jadwal Acara</h3>
              </div>
            </div>

            <div class="ac-timeline-right">
              <div class="ac-mobile-header">
                <span class="ac-step-badge">Fase 04</span>
                <h3>Jadwal Acara</h3>
              </div>

              <div class="ac-card-panel">
                <p class="kicker">Jadwal Penting</p>
                <h2 style="font-size:clamp(1.6rem, 3vw, 2.2rem); margin-bottom:10px">Agenda Menuju Hari-H</h2>
                <p class="lede" style="margin-bottom:28px">Catat tanggal-tanggal penting agar persiapan Anda dan keluarga maksimal.</p>

                <div class="timeline-row">
                  <div class="timeline-step">
                    <div class="step-date">1 – 7 Oktober</div>
                    <div class="step-title">Pendaftaran Early Bird</div>
                    <p class="step-desc">Tarif spesial Rp 100.000 (termasuk infaq Rp 20.000).</p>
                  </div>
                  <div class="timeline-step">
                    <div class="step-date">8 Oktober – 15 November</div>
                    <div class="step-title">Pendaftaran Normal</div>
                    <p class="step-desc">Tarif normal Rp 120.000 (termasuk infaq Rp 20.000).</p>
                  </div>
                  <div class="timeline-step">
                    <div class="step-date">19 – 20 November</div>
                    <div class="step-title">Race Pack Collection (RPC)</div>
                    <p class="step-desc">Pengambilan jersey, goodie bag & gelang resmi dengan menunjukkan e-ticket.</p>
                  </div>
                  <div class="timeline-step active">
                    <div class="step-date">Sabtu, 21 November</div>
                    <div class="step-title">Hari-H Pelaksanaan</div>
                    <p class="step-desc">Kumpul 05.30 WIB, Flag-off 06.00 WIB di DOME Bale Rame Soreang.</p>
                  </div>
                </div>

                <div style="text-align:center; margin-top:32px">
                  <a href="/jadwal" class="link-more">Lihat Jadwal Penting & RPC →</a>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>


  <!-- CTA Banner Akhir -->
  <section class="sec sec--deep" style="text-align:center">
    <div class="wrap" style="max-width:760px">
      <h2 style="font-size:clamp(2rem, 4vw, 3rem)">Siap Jadi Bagian dari 2.000 Langkah Sehat dan Berkah?</h2>
      <p class="lede" style="margin:16px auto 32px">
        Ajak keluarga, sahabat, dan rekan kerja Anda. Bersama BAZNAS Kabupaten Bandung, wujudkan tubuh bugar dan tabungan pahala yang mengalir.
      </p>
      <div style="display:flex; justify-content:center; gap:16px; flex-wrap:wrap">
        <a href="/daftar" class="btn btn-sun btn-lg">Daftar Sekarang Juga</a>
        <a href="/cek-tiket" class="btn btn-ghost btn-lg">Cek Status E-Ticket</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero-section {
    position: relative;
    background: var(--ink-deep);
    padding-bottom: 60px;
  }

  .hero-image-box {
    width: 100%;
    max-height: 520px;
    overflow: hidden;
    position: relative;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    filter: brightness(0.95);
  }

  .hero-wrap {
    position: relative;
    margin-top: -80px;
    z-index: 10;
  }

  .hero-card {
    background: var(--ink);
    border-radius: var(--r-xl);
    padding: clamp(28px, 4vw, 48px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  .hero-badge-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .hero-title {
    color: #FFFFFF;
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    line-height: 1.05;
    margin-bottom: 6px;
  }

  .hero-tagline {
    color: var(--lime);
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 22px;
  }

  .hero-meta {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 28px;
  }

  .hero-meta li {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #E2EDE0;
  }

  .meta-icon {
    font-size: 1.3rem;
    background: rgba(255, 255, 255, 0.08);
    width: 38px;
    height: 38px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .meta-lbl {
    display: block;
    font-size: 0.78rem;
    color: #9DBFA0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hero-meta b {
    color: #FFFFFF;
    font-size: 1.02rem;
  }

  .hero-cta-box {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Pricing Card */
  .hero-pricing-card {
    background: #FFFFFF;
    border-radius: var(--r-lg);
    padding: clamp(24px, 3vw, 34px);
    color: var(--grey-d);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
    position: relative;
    border: 3px solid var(--sun);
  }

  .pricing-badge {
    position: absolute;
    top: -14px;
    right: 24px;
    background: var(--sun);
    color: var(--ink-deep);
    font-family: 'Baloo 2', sans-serif;
    font-weight: 800;
    font-size: 0.8rem;
    padding: 3px 14px;
    border-radius: 99px;
    letter-spacing: 0.04em;
  }

  /* Quota Progress Box */
  .quota-progress-box {
    background: #FFFBEB;
    border: 1px solid #FCD34D;
    border-radius: var(--r-sm);
    padding: 8px 12px;
    margin-bottom: 14px;
  }

  .quota-meta {
