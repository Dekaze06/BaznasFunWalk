  .ac-timeline-track {
    position: absolute;
    left: 24px;
    top: 40px;
    bottom: 80px;
    width: 2px;
    background: linear-gradient(to bottom, rgba(16, 185, 129, 0.05) 0%, #D8E6D9 10%, #D8E6D9 90%, rgba(16, 185, 129, 0.05) 100%);
    border-radius: 99px;
    z-index: 1;
