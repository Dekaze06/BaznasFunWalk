    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0;
    background: linear-gradient(to bottom, #10B981 0%, #059669 60%, #F59E0B 100%);
    border-radius: 99px;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.7), 0 0 24px rgba(245, 158, 11, 0.4);
