---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Jadwal & Agenda Pendaftaran — BAZNAS Fun Walk 2026" activePage="jadwal">
  <!-- Page Header -->
  <section class="sec sec--dark page-header">
    <div class="wrap">
      <p class="kicker">Jadwal & Agenda</p>
      <h1>Timeline & Jadwal Pendaftaran Acara</h1>
      <p class="lede">
        Panduan waktu pendaftaran Early Bird, Normal, hingga jadwal pengambilan paket race pack (RPC) resmi BAZNAS Fun Walk 2026.
      </p>
    </div>
  </section>

  <!-- Agenda Pendaftaran & RPC -->
  <section class="sec">
    <div class="wrap grid-2">
      <div>
        <p class="kicker">Jadwal Penting</p>
        <h2>Agenda Pendaftaran & Pengambilan Paket</h2>
        <p class="lede">
          Pastikan Anda memperhatikan jadwal pendaftaran dan hadir mengambil paket race pack sesuai waktu yang ditentukan.
        </p>
        
        <div class="rpc-schedule-cards">
          <div class="rpc-card" style="border-left: 4px solid var(--sun);">
            <div class="rpc-day">1 – 7 Oktober 2026</div>
            <div class="rpc-time">Pendaftaran Early Bird</div>
            <div class="rpc-note">Tarif hemat Rp 100.000 (Termasuk donasi ZIS Rp 20.000)</div>
          </div>
          <div class="rpc-card" style="border-left: 4px solid var(--leaf);">
            <div class="rpc-day">8 Oktober – 15 November 2026</div>
            <div class="rpc-time">Pendaftaran Normal</div>
            <div class="rpc-note">Tarif Rp 120.000 (Termasuk donasi ZIS Rp 20.000)</div>
          </div>
          <div class="rpc-card">
            <div class="rpc-day">Kamis, 19 November 2026</div>
            <div class="rpc-time">Pukul 09.00 – 17.00 WIB</div>
            <div class="rpc-note">Hari pertama pengambilan paket peserta (RPC)</div>
          </div>
          <div class="rpc-card rpc-card--highlight">
            <div class="rpc-day">Jumat, 20 November 2026</div>
            <div class="rpc-time">Pukul 09.00 – 18.00 WIB</div>
            <div class="rpc-note">Hari terakhir pengambilan paket sebelum Hari-H (Istirahat Jumat 11.30–13.00)</div>
          </div>
        </div>
      </div>

      <div class="card-clean rpc-terms">
        <h4>Syarat & Tata Cara Pengambilan Race Pack:</h4>
        <ul class="rpc-steps">
          <li>
            <span class="step-num">1</span>
            <div>
              <b>Tunjukkan E-Ticket Digital:</b>
              <p>Cukup perlihatkan Kode QR pada e-ticket di smartphone Anda (cek di menu <a href="/cek-tiket">Cek Tiket</a>).</p>
            </div>
          </li>
          <li>
            <span class="step-num">2</span>
            <div>
              <b>Bisa Diwakilkan?</b>
              <p>Bisa, cukup tunjukkan foto atau screenshot E-Ticket peserta.</p>
            </div>
          </li>
        </ul>

        <div class="rpc-location-box">
          <b>Lokasi Pengambilan Race Pack:</b>
          <p>Jl. Terusan Alfathu KM 17 No.3 Desa Pamekaran, Soreang 40377 (Kantor Baznas Kabupaten Bandung Belakang Gedung Ormas)</p>
        </div>
      </div>
    </div>

    <div style="text-align:center; margin-top:48px">
      <a href="/daftar" class="btn btn-sun btn-lg">Daftar Sekarang Ikut Jalan Sehat 5K →</a>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: clamp(50px, 6vw, 80px) 0;
  }

  .rpc-schedule-cards {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 24px;
  }

  .rpc-card {
    background: #FFFFFF;
    border: 1.5px solid var(--line);
    border-radius: var(--r-md);
    padding: 16px 20px;
    box-shadow: var(--shadow-sm);
  }

  .rpc-card--highlight {
    background: var(--paper-2);
  }

  .rpc-day {
    font-weight: 800;
    color: var(--ink);
    font-size: 1.05rem;
    margin-bottom: 4px;
  }

  .rpc-time {
    color: var(--leaf);
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 4px;
  }

  .rpc-note {
    color: var(--grey-d);
    font-size: 0.85rem;
  }

  .rpc-terms {
    background: #FFFFFF;
  }

  .rpc-terms h4 {
    margin: 0 0 16px 0;
    color: var(--ink);
    font-size: 1.1rem;
  }

  .rpc-steps {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .rpc-steps li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .rpc-steps .step-num {
    background: var(--moss);
    color: #FFFFFF;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .rpc-steps b {
    display: block;
    color: var(--ink);
    margin-bottom: 2px;
    font-size: 0.95rem;
  }

  .rpc-steps p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--grey-d);
    line-height: 1.4;
  }

  .rpc-steps a {
    color: var(--leaf);
    font-weight: 700;
    text-decoration: underline;
  }

  .rpc-location-box {
    background: var(--paper-2);
    border: 1px dashed var(--leaf);
    border-radius: var(--r-sm);
    padding: 14px 16px;
  }

  .rpc-location-box b {
    color: var(--ink);
    display: block;
    margin-bottom: 2px;
  }

  .rpc-location-box p {
    margin: 0;
    color: var(--grey-d);
    line-height: 1.45;
  }
</style>
