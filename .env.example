# Midtrans Payment Gateway Configuration
# Dapatkan Server Key & Client Key dari Midtrans Portal (https://dashboard.sandbox.midtrans.com)

# Server Key (Rahasia - Hanya untuk Backend)
MIDTRANS_SERVER_KEY=SB-Mid-server-sandbox-demo-key

# Client Key (Publik - Untuk Frontend Snap JS)
PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-sandbox-demo-key

# Environment: false untuk Sandbox, true untuk Production
MIDTRANS_IS_PRODUCTION=false
